+[ -f "$SCRIPT" ] || { echo "FAIL: verify-tests not found at $SCRIPT" >&2; exit 1; }
+# Without rg, every count below is empty and the tallies break; stop with one clear line instead.
+command -v rg >/dev/null 2>&1 || { echo "tests need rg (ripgrep)" >&2; exit 2; }
+# dash if present; otherwise sh, with one NOTE line.
+if command -v dash >/dev/null 2>&1; then ALTSH=dash; else ALTSH=sh; echo "NOTE: dash not installed - alt-shell cases run under sh"; fi
+fails=0; passes=0
+ok()   { passes=$((passes+1)); echo "  PASS: $1"; }
+bad()  { fails=$((fails+1));  echo "  FAIL: $1"; }
+chk()  { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1 (expected [$3] got [$2])"; fi; }
+has()  { if printf '%s\n' "$2" | rg -qF -- "$3"; then ok "$1"; else bad "$1 (missing [$3] in: $2)"; fi; }
+hasnt(){ if printf '%s\n' "$2" | rg -qF -- "$3"; then bad "$1 (unexpected [$3] in: $2)"; else ok "$1"; fi; }
+
+tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
+
+# mkplan FILE TASKLINES: one task task-a owning t/a.sh; the caller supplies extra yaml lines.
+mkplan() {
+  { echo "---"; echo "title: demo"; echo "---"; echo
+    printf '%s\n' '```mermaid' 'flowchart TD' '    stale["stale"]' '```' '' '## Tasks' '' '## Task: one' '' '```yaml' 'id: task-a' 'depends_on: []' 'files:' '  - t/a.sh' 'status: pending'
+    [ -n "$2" ] && printf '%s\n' "$2"
+    printf '%s\n' '```' '' 'Body.'; } > "$1"
+}
+mkplan "$tmp/notests.md" ""
+mkplan "$tmp/nobase.md" 'tests:
+  - t/a.sh :: case one'
+
+# runall SHELL: the argument cases under one shell; sets out/err/rc per case via chk calls.
+run() { out="$($1 "$SCRIPT" "${@:2}" 2>"$tmp/e")"; rc=$?; err="$(cat "$tmp/e")"; }
+
+echo "args: usage"
+for n in 0 1 3; do
+  case $n in 0) set --;; 1) set -- "$tmp/notests.md";; 3) set -- "$tmp/notests.md" task-a extra;; esac
+  run sh "$@"
+  chk "usage: $n arguments exit 2, stdout empty" "$rc:$out" "2:"
+  has "usage: $n arguments name the usage line" "$err" "verify-tests <plan> <id>"
+done
+# One case name per criterion: the three counts above fold into this one.
+run sh; r0="$rc:$out"; run sh "$tmp/notests.md"; r1="$rc:$out:$err"; run sh "$tmp/notests.md" task-a x; r3="$rc:$out:$err"
