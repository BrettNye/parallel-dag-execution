+vt "$tmp/t1"
+chk "tails: spec example order" "$rc:$(hdrs)" "1:ok-absent${TAB}t/a.sh${TAB}x
+not-green${TAB}t/b.sh${TAB}y
+verify-tests: T1: 1 ok, 1 failed
+--- t/a.sh (before)
+--- t/b.sh (after)"
+chk "tails: spec example bodies" "$(printf '%s\n' "$full" | sed -n '/^---/,$p')" "--- t/a.sh (before)
+  | $(:)
+--- t/b.sh (after)
+  | detail-b
+  | FAIL: y"
+
+defaults; BODY='i=1; while [ $i -le 30 ]; do echo "line $i"; i=$((i+1)); done; echo "FAIL: adds"'
+scen "$tmp/t2" "x" "x"
+vt "$tmp/t2"
+blk="$(printf '%s\n' "$full" | sed -n '/^---/,$p' | sed 1d)"
+chk "tails: last 20 lines only" "$(printf '%s\n' "$blk" | wc -l | tr -d ' '):$(printf '%s\n' "$blk" | rg -c '^  \| '):$(printf '%s\n' "$blk" | sed -n '1p;$p' | tr '\n' '/')" "20:20:  | line 12/  | FAIL: adds/"
+
+defaults; scen "$tmp/t3" "PASS: adds" "FAIL: adds"
+vt "$tmp/t3"
+chk "tails: not-red and not-green gives only after" "$(printf '%s\n' "$full" | rg '^---')" "--- t/demo.test.sh (after)"
+
+defaults; TESTS="t/demo.test.sh :: a
+t/demo.test.sh :: b"
+scen "$tmp/t4" "" "FAIL: a
+PASS: b"
+vt "$tmp/t4"
+chk "tails: one file gives after then before" "$(printf '%s\n' "$full" | rg '^(---|ok|not)')" "not-green${TAB}t/demo.test.sh${TAB}a
+ok-absent${TAB}t/demo.test.sh${TAB}b
+--- t/demo.test.sh (after)
+--- t/demo.test.sh (before)"
+
+defaults; SUITE="t/a.sh"; MORE="t/b.sh"; TESTS="t/b.sh :: y
+t/a.sh :: x"
+scen "$tmp/t5" "-" "x"
+addsuite "$tmp/t5" t/b.sh 'echo "FAIL: y"'
+vt "$tmp/t5"
+chk "tails: file order follows tests:" "$(printf '%s\n' "$full" | rg '^---')" "--- t/b.sh (after)
+--- t/a.sh (after)"
+
+defaults; MORE="t/gone.test.sh"; TESTS="t/gone.test.sh :: z"
+scen "$tmp/t6" "x" "x"
+vt "$tmp/t6"
+chk "tails: no output shows placeholder" "$(printf '%s\n' "$full" | sed -n '/^---/,$p')" "--- t/gone.test.sh (after)
+  | (no output)"
+
+defaults; scen "$tmp/t7" "FAIL: adds" "PASS: adds"
+vt "$tmp/t7"
+chk "tails: all ok prints no block" "$rc:$full:$(printf '%s\n' "$full" | rg '^---' | wc -l | tr -d ' ')" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed:0"
