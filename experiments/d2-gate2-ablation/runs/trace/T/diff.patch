+# The tails that explain a label: not-green and ambiguous show the after run, not-red and
+# ok-absent the before run, so an entry that is both not-red and not-green shows only after.
+# A file gets each block once, in the order its first entry appears in tests:.
+tail_block() {  # $1 header, $2 captured output
+  printf '%s\n' "$1"
+  if [ -s "$2" ]; then tail -n 20 "$2" | sed 's/^/  | /'; else printf '  | (no output)\n'; fi
+}
+i=1
+while [ "$i" -le "$nfiles" ]; do
+  f=$(cat "$work/f.$i")
+  want=$(VT_FILE=$f awk -F '\t' '
+    BEGIN { f = ENVIRON["VT_FILE"] }
+    $2 == f { if ($1 == "not-green" || $1 == "ambiguous") a = 1; else if ($1 == "not-red" || $1 == "ok-absent") b = 1 }
+    END { print (a ? "a" : "-") (b ? "b" : "-") }' "$work/labels")
+  case $want in a*) tail_block "--- $f (after)" "$work/o.after.$i" ;; esac
+  case $want in *b) tail_block "--- $f (before)" "$work/o.before.$i" ;; esac
+  i=$((i + 1))
+done
+cleanup || exit 2
+exit "$lrc"
