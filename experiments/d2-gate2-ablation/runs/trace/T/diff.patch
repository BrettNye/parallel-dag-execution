+      if (ei[e] != fi) continue
+      pl = pp ec[e]; fl = fp ec[e]
+      if ($0 == pl) np[e, tr]++
+      else if ($0 == fl || substr($0, 1, length(fl) + 2) == fl " (") nf[e, tr]++
+    }
+  }
+  function state(e, tr,   n) { n = np[e, tr] + nf[e, tr]; return n == 0 ? "absent" : n > 1 ? "ambiguous" : np[e, tr] ? "passed" : "failed" }
