+      else if (b == "passed") l = "not-red"
+      else if (b == "absent") l = "ok-absent"
+      else l = "ok"
+      if (l == "ok" || l == "ok-absent") nok++; else nbad++
+      print l "\t" ef[e] "\t" ec[e]
+    }
+    print "verify-tests: " ID ": " (nok + 0) " ok, " (nbad + 0) " failed"
