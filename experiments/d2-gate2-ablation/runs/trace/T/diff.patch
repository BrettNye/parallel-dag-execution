+
+run sh "$tmp/notests.md" zz
+chk "args: plan-state error is relayed" "$rc:$out" "2:"
+has "args: plan-state error is relayed (message)" "$err" "plan-state: no task with id zz"
+run sh "$tmp/missing.md" task-a
+chk "args: unreadable plan is relayed" "$rc:$out" "2:"
+has "args: unreadable plan is relayed (message)" "$err" "plan-state: cannot read"
+
+run sh "$tmp/notests.md" task-a
+chk "args: no named tests exits 0" "$rc:$out" "0:verify-tests: task-a: no named tests"
+
+run sh "$tmp/nobase.md" task-a
+chk "args: no base_sha exits 2" "$rc:$out" "2:"
+has "args: no base_sha exits 2 (message)" "$err" "verify-tests: task-a: no base_sha (set the task running first)"
+
+echo "args: runs under $ALTSH"
+run $ALTSH "$tmp/notests.md" zz; a="$rc"
+run $ALTSH "$tmp/missing.md" task-a; b="$rc"
+run $ALTSH "$tmp/notests.md" task-a; c="$rc:$out"
+run $ALTSH "$tmp/nobase.md" task-a; d="$rc"
+run $ALTSH; e="$rc"
+chk "args: runs under dash" "$e:$a:$b:$c:$d" "2:2:2:0:verify-tests: task-a: no named tests:2"
+
+# ---- trees: a task's named cases, red before and green after ----
+PS="$REPO/skills/writing-dag-plans/plan-state"
+TAB="$(printf '\t')"
+export TMPDIR="$tmp/tt"; mkdir -p "$TMPDIR"
+ALLOUT=""
+# The default suite: prints lib.txt, or a fail line for "adds" when lib.txt is missing.
+DEFBODY='if [ -f lib.txt ]; then cat lib.txt; else echo "FAIL: adds (no lib.txt)"; fi'
+# scen DIR BEFORE AFTER: a repository whose task T1 owns lib.txt and $SUITE (body $BODY), with
+# tests: $TESTS and front matter $FRONT. lib.txt holds BEFORE at base_sha ("-" = no file) and
+# AFTER at HEAD. The plan is committed after T1 is set running, so the shared tree is clean.
+scen() {
+  d=$1; mkdir -p "$d/t"; git init -q "$d"
+  git -C "$d" config user.email t@example.com; git -C "$d" config user.name t; git -C "$d" config core.autocrlf false
+  [ "$2" = "-" ] || printf '%s\n' "$2" > "$d/lib.txt"
+  printf '%s\n' "${BODY:-$DEFBODY}" > "$d/$SUITE"
+  { echo "---"; echo "title: demo"; [ -n "$FRONT" ] && printf '%s\n' "$FRONT"; echo "---"; echo
+    printf '%s\n' '```mermaid' 'flowchart TD' '    T1["one"]' '```' '' '## Tasks' '' '## Task: one' '' '```yaml' 'id: T1' 'depends_on: []' 'files:' '  - lib.txt' "  - $SUITE" ${MORE:+"  - $MORE"} 'status: ready' 'tests:'
+    printf '%s\n' "$TESTS" | sed 's/^/  - /'
+    printf '%s\n' '```' '' 'Body.'; } > "$d/plan.md"
+  git -C "$d" add -A && git -C "$d" commit -qm base
+  sh "$PS" set "$d/plan.md" T1 running >/dev/null || echo "scen: set running failed in $d" >&2
+  git -C "$d" add -A && git -C "$d" commit -qm running
+  printf '%s\n' "$3" > "$d/lib.txt"; git -C "$d" add -A && git -C "$d" commit -q --allow-empty -m change
+}
+defaults() { SUITE="t/demo.test.sh"; MORE=""; BODY=""; FRONT=""; TESTS="t/demo.test.sh :: adds"; }
+# vt DIR: run verify-tests on DIR's plan; sets full (all stdout), out (the lines before the first
+# tail block), err and rc, and adds out to ALLOUT.
+vt() { full="$(sh "$SCRIPT" "$1/plan.md" T1 2>"$tmp/e")"; rc=$?; err="$(cat "$tmp/e")"
+  out="$(printf '%s\n' "$full" | awk '/^---/ { exit } { print }')"; ALLOUT="$ALLOUT
+$out"; }
+# addsuite DIR PATH BODY: commit another test file (present in both trees) to DIR.
+addsuite() { mkdir -p "$1/$(dirname "$2")"; printf '%s\n' "$3" > "$1/$2"; git -C "$1" add -A && git -C "$1" commit -qm "add $2"; }
+wtn() { git -C "$1" worktree list | wc -l | tr -d ' '; }
+tmpempty() { if [ -z "$(ls -A "$TMPDIR")" ]; then echo empty; else echo "left: $(ls -A "$TMPDIR")"; fi; }
+
+echo "trees: labels"
+defaults; scen "$tmp/r1" "FAIL: adds (got 0)" "PASS: adds"
+st0="$(git -C "$tmp/r1" status --porcelain)"; pl0="$(cksum < "$tmp/r1/plan.md")"; hd0="$(git -C "$tmp/r1" rev-parse HEAD)"
+vt "$tmp/r1"
+chk "trees: red then green is ok" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+chk "trees: shared tree untouched" "$(git -C "$tmp/r1" status --porcelain):$(cksum < "$tmp/r1/plan.md"):$(git -C "$tmp/r1" rev-parse HEAD)" "$st0:$pl0:$hd0"
+left0="$(wtn "$tmp/r1"):$(tmpempty)"
+
+defaults; scen "$tmp/r2" "" "PASS: adds"
+vt "$tmp/r2"
+chk "trees: absent before is ok-absent" "$rc:$out" "0:ok-absent${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+defaults; scen "$tmp/r3" "PASS: adds" "PASS: adds
+other line"
+vt "$tmp/r3"
+chk "trees: passing before is not-red" "$rc:$out" "1:not-red${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed"
+left1="$(wtn "$tmp/r3"):$(tmpempty)"
+chk "trees: no worktree or temp dir left" "$left0 $left1" "1:empty 1:empty"
+
+defaults; scen "$tmp/r4" "FAIL: adds (got 0)" "FAIL: adds (got 1)"
+vt "$tmp/r4"
+chk "trees: failing after is not-green" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed"
+
+defaults; scen "$tmp/r5" "PASS: adds" "FAIL: adds"
+vt "$tmp/r5"
+chk "trees: not-green wins over not-red" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed"
+
+defaults; scen "$tmp/r6" "FAIL: adds" "PASS: adds
+PASS: adds"
+vt "$tmp/r6"
+chk "trees: duplicate name is ambiguous" "$rc:$out" "1:ambiguous${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed"
+
+# x is red then green through a fail line with a ( detail; that line is not a result line for x2,
+# so x2 is absent before; "PASS: exit 0 with charter" is not a pass line for "exit 0".
+defaults; TESTS="t/demo.test.sh :: x
+t/demo.test.sh :: x2
+t/demo.test.sh :: exit 0"
+scen "$tmp/r7" "  FAIL: x (expected [1] got [2])" "PASS: x
+PASS: x2
+PASS: exit 0 with charter"
+vt "$tmp/r7"
+chk "trees: fail line with ( detail matches" "$rc:$out" "1:ok${TAB}t/demo.test.sh${TAB}x
+ok-absent${TAB}t/demo.test.sh${TAB}x2
+not-green${TAB}t/demo.test.sh${TAB}exit 0
+verify-tests: T1: 2 ok, 1 failed"
+
+defaults; FRONT='test_command: sh {file}
+test_pass_prefix: "ok - "
+test_fail_prefix: "not ok - "'
+scen "$tmp/r8" "not ok - adds (got 0)
+PASS: adds" "ok - adds"
+vt "$tmp/r8"
+chk "trees: custom command and prefixes" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+defaults; SUITE="t/it's a.test.sh"; TESTS="t/it's a.test.sh :: adds"
+scen "$tmp/r9" "FAIL: adds" "PASS: adds"
+vt "$tmp/r9"
+chk "trees: file with a space and a quote" "$rc:$out" "0:ok${TAB}t/it's a.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+defaults; scen "$tmp/r10" "FAIL: adds" "FAIL: adds"
+printf '%s\n' "PASS: adds" > "$tmp/r10/lib.txt"
+vt "$tmp/r10"
+chk "trees: uncommitted change is ignored" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed"
+
+defaults; scen "$tmp/r11" "-" "PASS: adds"
+vt "$tmp/r11"
+chk "trees: before tree deletes a path new since base" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+defaults; TESTS="t/demo.test.sh :: b
+t/demo.test.sh :: a"
+scen "$tmp/r12" "FAIL: a
+FAIL: b" "PASS: a
+PASS: b"
+vt "$tmp/r12"
+chk "trees: two entries keep tests: order" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}b
+ok${TAB}t/demo.test.sh${TAB}a
+verify-tests: T1: 2 ok, 0 failed"
+
+defaults; scen "$tmp/r13" "FAIL: adds" "PASS: adds"
+sed 's/^\( *\)base_sha: .*/\1base_sha: 0000000/' "$tmp/r13/plan.md" > "$tmp/r13/p" && mv "$tmp/r13/p" "$tmp/r13/plan.md"
+vt "$tmp/r13"
+chk "trees: base_sha not a commit" "$rc:$out" "2:"
+has "trees: base_sha not a commit (message)" "$err" "is not a commit"
+
+# The suite reads a git-ignored file that exists only in the shared working tree.
+defaults; BODY='if [ -f dep.txt ]; then cat dep.txt; else echo "FAIL: adds (no dep.txt)"; fi'
+scen "$tmp/r14" "FAIL: adds" "x"
+printf '%s\n' "dep.txt" > "$tmp/r14/.gitignore"; git -C "$tmp/r14" add .gitignore; git -C "$tmp/r14" commit -qm ignore
+printf '%s\n' "PASS: adds" > "$tmp/r14/dep.txt"
+vt "$tmp/r14"
+chk "trees: ignored dependency is not in the after tree" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed"
+
+# Every stdout above holds only label and total lines.
+badlines="$(printf '%s\n' "$ALLOUT" | awk -v T="$TAB" 'NF && $0 !~ /^verify-tests: T1: [0-9]+ ok, [0-9]+ failed$/ && $0 !~ ("^(ok|ok-absent|not-red|not-green|ambiguous)" T "[^" T "]+" T ".+$")')"
+chk "trees: git stdout never reaches stdout" "$badlines" ""
+
+# ---- tails: the last 20 lines of the runs that explain a label ----
+hdrs() { printf '%s\n' "$full" | rg '^(---|ok|not|verify)'; }
+
+# a.sh :: x is absent before and passes after; b.sh :: y fails after (and before).
+defaults; SUITE="t/a.sh"; MORE="t/b.sh"; BODY='cat lib.txt'; TESTS="t/a.sh :: x
+t/b.sh :: y"
+scen "$tmp/t1" "" "PASS: x"
