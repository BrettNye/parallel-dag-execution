+# ---- signals: a suite that sleeps, interrupted while it runs ----
+# sigrun DIR SHELL SIGNAL [COUNT]: start verify-tests in its own process group (a plain
+# background job has INT ignored, and a shell cannot trap a signal ignored on entry), wait until
+# the suite has started, then send SIGNAL COUNT times, 0.2s apart. Sets rc, so and err.
+sigrun() {
+  rm -f "$tmp/mark"
+  set -m; $2 "$SCRIPT" "$1/plan.md" T1 >"$tmp/so" 2>"$tmp/e" & pid=$!; set +m
+  n=0; while [ ! -f "$tmp/mark" ] && kill -0 "$pid" 2>/dev/null && [ "$n" -lt 300 ]; do sleep 0.1; n=$((n+1)); done
+  i=0; while [ "$i" -lt "${4:-1}" ]; do kill -"$3" "$pid" 2>/dev/null; i=$((i+1)); sleep 0.2; done
+  wait "$pid" 2>/dev/null; rc=$?; err="$(cat "$tmp/e")"; so="$(cat "$tmp/so")"
+}
+defaults; BODY="touch '$tmp/mark'; sleep \${VT_SLEEP:-20}; cat lib.txt"
+scen "$tmp/s1" "FAIL: adds" "PASS: adds"
+for sig in TERM INT HUP; do
+  r=""; exp=""
+  for sh_ in sh $ALTSH; do
+    sigrun "$tmp/s1" "$sh_" "$sig"
+    case "$err" in *"verify-tests: T1: interrupted"*) e=interrupted;; *) e="no message [$err]";; esac
+    r="$r $sh_=$rc:$so:$e:$(wtn "$tmp/s1"):$(tmpempty)"; exp="$exp $sh_=2::interrupted:1:empty"
+  done
+  chk "signals: $sig mid-run cleans up" "$r" "$exp"
+done
+
+sigrun "$tmp/s1" sh TERM 3
+chk "signals: second signal during cleanup still exits 2" "$rc:$(wtn "$tmp/s1"):$(tmpempty)" "2:1:empty"
+
+# KILL: no trap runs, so both worktrees and the temp dir stay. git worktree prune clears only a
+# registration whose directory is gone; once the temp dir is removed (as a temp cleaner would),
+# the next run's prune clears both.
+export VT_SLEEP=2
+sigrun "$tmp/s1" sh KILL
+sleep 3
+k1="$(wtn "$tmp/s1")"
+rm -rf "$TMPDIR"/*
+vt "$tmp/s1"; k2="$rc"
+unset VT_SLEEP
+chk "signals: KILL leaves a registration the next run prunes" "$k1:$k2:$(wtn "$tmp/s1"):$(tmpempty)" "3:0:1:empty"
+
+# ---- cleanup: a worktree that cannot be removed ----
+# The suite locks its own worktree, so "git worktree remove --force" (one --force) refuses it.
+defaults; BODY='git worktree lock "$PWD" >/dev/null 2>&1; cat lib.txt'
+scen "$tmp/c1" "FAIL: adds" "PASS: adds"
+vt "$tmp/c1"
+chk "cleanup: failed removal exits 2" "$rc:$out" "2:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+has "cleanup: failed removal exits 2 (message)" "$err" "verify-tests: T1: cleanup failed"
+
+echo "RESULT: $passes passed, $fails failed"
+[ "$fails" -eq 0 ]
