index 0000000..bb203db
--- /dev/null
+++ b/skills/executing-dag-plans/verify-tests
@@ -0,0 +1,186 @@
+#!/usr/bin/env sh
+# verify-tests — check that a task's named test cases were red before its change and green after.
+# Usage: verify-tests <plan> <id>
+# Exit: 0 every entry ok, or no entries; 1 at least one entry failed;
+#       2 usage, plan-state tests error, no base_sha, git failure, interrupt, or failed cleanup.
+# It never writes to the plan, touches the shared working tree or index, or commits.
+#
+# It builds two detached worktrees at HEAD in a mktemp -d directory: "after" as committed, and
+# "before" with the task's files other than its test files put back to base_sha. Each test file
+# runs once in each tree; each tests: entry gets one label from the two runs.
+# Untracked files: only committed files are in the trees, so a suite that needs an untracked or
+# ignored file (a dependency, a local config) fails there. On this repository (2026-11-18, HEAD
+# 4ad7675) a running task owning plan-state and its suite, base_sha 76ed77d^, gave "ok" for
+# 'round on "2" writes review_rounds: 3' and "not-red" for 'round on "2" counts to 3' (the old
+# round printed 3 without writing it): the repo's own suites need nothing untracked.
+# Bash tool timeout: no signal. On 2026-11-18 the Claude Code Bash tool (Windows, Git Bash) ran
+# sh -c 'trap "echo INT >> /tmp/vt-probe.log; exit 2" INT; trap "echo TERM >> /tmp/vt-probe.log; exit 2" TERM; trap "echo HUP >> /tmp/vt-probe.log; exit 2" HUP; sleep 60 & wait'
+# with timeout: 5000. The log stayed empty: at the timeout the tool moved the command to the
+# background and let it finish (exit 0) instead of signalling it.
+# Signals: INT, TERM and HUP stop the running suite, remove both trees and the temp dir, print
+# "interrupted" and exit 2; further signals during that cleanup are ignored. KILL cannot be
+# caught: the trees and the temp dir stay until the temp dir is removed, after which the next
+# run's "git worktree prune" clears the registrations.
+set -u
+usage() { sed -n '3,5p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
+[ "$#" -eq 2 ] || usage
+plan=$1; id=$2
+here=$(cd "$(dirname -- "$0")" && pwd)
+ps="$here/../writing-dag-plans/plan-state"
+work=$(mktemp -d) || exit 2
+repo=""; child=""
+
+# Remove both trees and the temp dir; on any failure say so and return 1.
+cleanup() {
+  crc=0
+  for w in after before; do
+    if [ -d "$work/$w" ]; then git -C "$repo" worktree remove --force "$work/$w" >/dev/null 2>&1 || crc=1; fi
+  done
+  rm -rf "$work" 2>/dev/null; [ -e "$work" ] && crc=1
+  [ "$crc" -eq 0 ] || echo "verify-tests: $id: cleanup failed" >&2
+  return "$crc"
+}
+# A trap runs only after the foreground command returns, so suites run in the background and are
+# waited for; the trap stops the suite (its process group when job control gave it one).
+on_signal() {
+  trap '' INT TERM HUP
+  if [ -n "$child" ]; then
+    kill -TERM "-$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null
+    wait "$child" 2>/dev/null
+  fi
+  cleanup
+  echo "verify-tests: $id: interrupted" >&2
+  exit 2
+}
+trap on_signal INT TERM HUP
+fail() { echo "verify-tests: $id: $1" >&2; cleanup; exit 2; }
+
+rec="$work/rec"; perr="$work/err"
+if ! sh "$ps" tests "$plan" "$id" > "$rec" 2> "$perr"; then cat "$perr" >&2; cleanup; exit 2; fi
+base=""; ntest=0
+while IFS= read -r line; do
+  case $line in
+    "base "*) base=${line#base } ;;
+    "test "*) ntest=$((ntest + 1)) ;;
+  esac
+done < "$rec"
+if [ "$ntest" -eq 0 ]; then echo "verify-tests: $id: no named tests"; cleanup; exit 0; fi
+[ "$base" = "-" ] && fail "no base_sha (set the task running first)"
+
+repo=$(git -C "$(dirname -- "$plan")" rev-parse --show-toplevel 2>/dev/null) || fail "not in a git repository"
+git -C "$repo" worktree prune >/dev/null 2>&1
+head=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null) || fail "cannot read HEAD"
+git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || fail "base_sha $base is not a commit"
+
+# Per distinct test file i: f.i holds the path, c.i the command with {file} quoted for sh.
+# restore lists the task's other files, put back to base_sha in the before tree. Prints the count.
+nfiles=$(awk -v W="$work" -v Q="'" '
+  function shq(s,   o, i) { o = Q; while ((i = index(s, Q)) > 0) { o = o substr(s, 1, i - 1) Q "\\" Q Q; s = substr(s, i + 1) } return o s Q }
+  function subst(c, r,   o, i) { o = ""; while ((i = index(c, "{file}")) > 0) { o = o substr(c, 1, i - 1) r; c = substr(c, i + 6) } return o c }
+  substr($0, 1, 8) == "command " { cmd = substr($0, 9) }
+  substr($0, 1, 5) == "file " { nf++; fl[nf] = substr($0, 6) }
+  substr($0, 1, 5) == "test " { t = substr($0, 6); t = substr(t, 1, index(t, "\t") - 1); if (!(t in seen)) { seen[t] = 1; n++; tf[n] = t } }
+  END {
+    for (i = 1; i <= n; i++) { p = W "/f." i; print tf[i] > p; close(p); p = W "/c." i; print subst(cmd, shq(tf[i])) > p; close(p) }
+    p = W "/restore"; printf "" > p
+    for (i = 1; i <= nf; i++) if (!(fl[i] in seen)) print fl[i] > p
+    close(p); print n + 0
+  }' "$rec") || fail "cannot read the tests record"
+
+git -C "$repo" worktree add --detach "$work/after" "$head" >/dev/null 2>"$perr" || { cat "$perr" >&2; fail "cannot add the after tree"; }
+git -C "$repo" worktree add --detach "$work/before" "$head" >/dev/null 2>"$perr" || { cat "$perr" >&2; fail "cannot add the before tree"; }
+while IFS= read -r p; do
+  if git -C "$repo" cat-file -e "$base:$p" 2>/dev/null; then
+    git --literal-pathspecs -C "$work/before" checkout "$base" -- "$p" >/dev/null 2>"$perr" || { cat "$perr" >&2; fail "cannot put back $p"; }
+  else
+    rm -f -- "$work/before/$p"
