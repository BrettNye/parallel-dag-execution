+#!/usr/bin/env bash
+# Test suite for skills/executing-dag-plans/verify-tests
+REPO="$(cd "$(dirname "$0")/../.." && pwd)"
+SCRIPT="$REPO/skills/executing-dag-plans/verify-tests"
+[ -f "$SCRIPT" ] || { echo "FAIL: verify-tests not found at $SCRIPT" >&2; exit 1; }
+command -v rg >/dev/null 2>&1 || { echo "tests need rg (ripgrep)" >&2; exit 2; }
+# A second POSIX shell, to catch bashisms. dash if present; otherwise sh.
+if command -v dash >/dev/null 2>&1; then ALTSH=dash; else ALTSH=sh; echo "NOTE: dash not installed - alt-shell cases run under sh"; fi
+fails=0; passes=0
+ok()   { passes=$((passes+1)); echo "  PASS: $1"; }
+bad()  { fails=$((fails+1));  echo "  FAIL: $1"; }
+chk()  { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1 (expected [$3] got [$2])"; fi; }
+has()  { if printf '%s\n' "$2" | rg -qF -- "$3"; then ok "$1"; else bad "$1 (missing [$3] in: $2)"; fi; }
+hasnt(){ if printf '%s\n' "$2" | rg -qF -- "$3"; then bad "$1 (unexpected [$3] in: $2)"; else ok "$1"; fi; }
+
+tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
+
+# A two-task plan. task-a has no tests:. task-b has one tests: entry; $1 is the path,
+# $2 is an optional base_sha line for task-b.
+mkplan() {
+{
+cat <<'EOT'
+---
+title: demo
+created: 2026-11-17
+---
+
+## Context
+
+Demo.
+
+## Tasks
+
+## Task: plain
+
+```yaml
+id: task-a
+depends_on: []
+files:
+  - src/a.txt
+status: running
+```
+
+## Task: named
+
+```yaml
+id: task-b
+depends_on: []
+files:
+  - src/b.txt
+  - t/b.test.sh
+tests:
+  - t/b.test.sh :: case one
+status: running
+EOT
+[ -n "${2:-}" ] && printf '%s\n' "$2"
+printf '%s\n' '```'
+} > "$1"
+}
+
+echo "T1: arguments"
+mkplan "$tmp/p.md"
+for n in 0 1 3; do
+  case $n in
+    0) out="$(sh "$SCRIPT" 2>"$tmp/e")"; rc=$? ;;
+    1) out="$(sh "$SCRIPT" "$tmp/p.md" 2>"$tmp/e")"; rc=$? ;;
+    3) out="$(sh "$SCRIPT" "$tmp/p.md" task-a extra 2>"$tmp/e")"; rc=$? ;;
+  esac
+  err="$(cat "$tmp/e")"
+  if [ "$n" = 0 ]; then
+    chk "args: no arguments is usage" "$rc:$out" "2:"
+    has "args: no arguments is usage (stderr)" "$err" "verify-tests <plan> <id>"
+  else
+    chk "args: $n argument(s) exit 2, stdout empty" "$rc:$out" "2:"
+    has "args: $n argument(s) print usage" "$err" "verify-tests <plan> <id>"
+  fi
+done
+
+echo
+echo "T2: plan-state errors are relayed"
+out="$(sh "$SCRIPT" "$tmp/p.md" zz 2>"$tmp/e")"; rc=$?
+chk "args: plan-state error is relayed" "$rc:$out" "2:"
+has "args: unknown id message" "$(cat "$tmp/e")" "plan-state: no task with id zz"
+out="$(sh "$SCRIPT" "$tmp/missing.md" task-a 2>"$tmp/e")"; rc=$?
+chk "args: unreadable plan is relayed" "$rc:$out" "2:"
+has "args: unreadable plan message" "$(cat "$tmp/e")" "plan-state: cannot read"
+
+echo
+echo "T3: no named tests, plan outside any repository"
+out="$(sh "$SCRIPT" "$tmp/p.md" task-a 2>"$tmp/e")"; rc=$?
+chk "args: no named tests exits 0" "$rc:$out" "0:verify-tests: task-a: no named tests"
+
+echo
+echo "T4: no base_sha"
+out="$(sh "$SCRIPT" "$tmp/p.md" task-b 2>"$tmp/e")"; rc=$?
+chk "args: no base_sha exits 2" "$rc:$out" "2:"
+has "args: no base_sha message" "$(cat "$tmp/e")" "verify-tests: task-b: no base_sha (set the task running first)"
+
+echo
+echo "T5: runs under a second POSIX shell ($ALTSH)"
+out="$($ALTSH "$SCRIPT" 2>/dev/null)"; rc1=$?
+out="$($ALTSH "$SCRIPT" "$tmp/p.md" zz 2>/dev/null)"; rc2=$?
+out="$($ALTSH "$SCRIPT" "$tmp/p.md" task-a 2>/dev/null)"; rc3=$?
+out="$($ALTSH "$SCRIPT" "$tmp/p.md" task-b 2>/dev/null)"; rc4=$?
+chk "args: runs under dash" "$rc1$rc2$rc3$rc4" "2202"
+
+# ---------------------------------------------------------------------------
+# Trees. Each fixture is a git repository under $tmp with an untracked plan.md whose
+# task T1 has a real base_sha. verify-tests runs with TMPDIR=$tt, so a leaked
+# temporary directory shows up there.
+export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
+tt="$tmp/tt"; mkdir -p "$tt"
+: > "$tmp/allout"
+# vt <plan> [shell]: run verify-tests on T1; sets out, err, rc; every stdout is kept in allout.
+vt() {
+  out="$(TMPDIR="$tt" ${2:-sh} "$SCRIPT" "$1" T1 2>"$tmp/e")"; rc=$?
+  err="$(cat "$tmp/e")"; printf '%s\n' "$out" >> "$tmp/allout"
+}
+newrepo() {
+  rm -rf "$1"; mkdir -p "$1/t"
+  git -C "$1" init -q && git -C "$1" config core.autocrlf false
+}
+put()    { mkdir -p "$(dirname "$1/$2")"; printf '%s\n' "$3" > "$1/$2"; }
+commit() { git -C "$1" add -A && git -C "$1" commit -qm "$2"; }
+# writeplan <dir> <base> <files, one per line> <tests, one per line> [extra front matter lines]
+writeplan() {
+  {
+    printf -- '---\ntitle: demo\ncreated: 2026-11-17\n'
+    [ -n "${5:-}" ] && printf '%s\n' "$5"
+    printf -- '---\n\n## Tasks\n\n## Task: one\n\n```yaml\nid: T1\ndepends_on: []\nfiles:\n'
+    printf '%s\n' "$3" | while IFS= read -r f; do printf '  - %s\n' "$f"; done
+    printf 'tests:\n'
+    printf '%s\n' "$4" | while IFS= read -r f; do printf '  - %s\n' "$f"; done
+    printf 'status: running\nbase_sha: %s\n```\n' "$2"
+  } > "$1/plan.md"
+}
+wtcount() { git -C "$1" worktree list --porcelain | rg -c '^worktree '; }
+# labels <stdout>: only the label and total lines, without the output tails that follow them.
+labels() { printf '%s\n' "$1" | rg -v '^(--- |  \| )'; }
+# block <stdout> <n>: the nth tail block (header and its "  | " lines).
+block() { printf '%s\n' "$1" | awk -v N="$2" '/^--- /{k++} k==N'; }
+
+LIB_BAD='add() { echo 0; }'
+LIB_GOOD='add() { echo $(($1 + $2)); }'
+LIB_GOOD2='add() { echo $(($2 + $1)); }'
+# The suite sleeps only when VT_MARK is set (signal cases): it touches the mark, then sleeps.
+SUITE_ADDS='[ -n "${VT_MARK:-}" ] && { touch "$VT_MARK"; sleep "${VT_SLEEP:-30}"; }
+. ./lib.sh
+if [ "$(add 1 2)" = 3 ]; then echo "PASS: adds"; else echo "FAIL: adds (got $(add 1 2))"; fi'
+# mk <dir> <lib at base> <lib after>: base commit, base_sha, then the task's commit.
+mk() {
+  newrepo "$1"; put "$1" lib.sh "$2"; put "$1" t/demo.test.sh "$SUITE_ADDS"; commit "$1" base
+  b=$(git -C "$1" rev-parse HEAD)
+  put "$1" lib.sh "$3"; commit "$1" task
+  writeplan "$1" "$b" "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: adds"
+}
+
+echo
+echo "T6: labels"
+mk "$tmp/r1" "$LIB_BAD" "$LIB_GOOD"
+vt "$tmp/r1/plan.md"
+chk "trees: red then green is ok" "$rc:$(labels "$out")" "0:ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+# The suite stops at its first line when new.sh, which the task creates, is missing.
+newrepo "$tmp/r2"
+put "$tmp/r2" t/demo.test.sh '[ -f new.sh ] || exit 1
+. ./new.sh
+echo "PASS: fresh"'
+commit "$tmp/r2" base; b=$(git -C "$tmp/r2" rev-parse HEAD)
+put "$tmp/r2" new.sh 'true'; commit "$tmp/r2" task
+writeplan "$tmp/r2" "$b" "new.sh
+t/demo.test.sh" "t/demo.test.sh :: fresh"
+vt "$tmp/r2/plan.md"
+chk "trees: absent before is ok-absent" "$rc:$(labels "$out")" "0:ok-absent	t/demo.test.sh	fresh
+verify-tests: T1: 1 ok, 0 failed"
+
+mk "$tmp/r3" "$LIB_GOOD" "$LIB_GOOD2"
+vt "$tmp/r3/plan.md"
+chk "trees: passing before is not-red" "$rc:$(labels "$out")" "1:not-red	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+newrepo "$tmp/r4"
+put "$tmp/r4" lib.sh "$LIB_BAD"
+put "$tmp/r4" t/demo.test.sh '. ./lib.sh
+if [ "$(add 1 2)" = 3 ]; then echo "PASS: x"; else echo "FAIL: x"; fi'
+commit "$tmp/r4" base; b=$(git -C "$tmp/r4" rev-parse HEAD)
+put "$tmp/r4" lib.sh "$LIB_GOOD"
+put "$tmp/r4" t/demo.test.sh '. ./lib.sh
+if [ "$(add 1 2)" = 3 ]; then echo "PASS: x"; else echo "FAIL: x"; fi
+echo "PASS: y"'
+commit "$tmp/r4" task
+writeplan "$tmp/r4" "$b" "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: y"
+vt "$tmp/r4/plan.md"
+chk "trees: new case passing on old code is not-red" "$rc:$(labels "$out")" "1:not-red	t/demo.test.sh	y
+verify-tests: T1: 0 ok, 1 failed"
+
+mk "$tmp/r5" "$LIB_BAD" 'add() { echo 4; }'
+vt "$tmp/r5/plan.md"
+chk "trees: failing after is not-green" "$rc:$(labels "$out")" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+mk "$tmp/r6" "$LIB_GOOD" "$LIB_BAD"
+vt "$tmp/r6/plan.md"
+chk "trees: not-green wins over not-red" "$rc:$(labels "$out")" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+newrepo "$tmp/r7"
+put "$tmp/r7" lib.sh "$LIB_BAD"
+put "$tmp/r7" t/demo.test.sh '. ./lib.sh
+echo "PASS: adds"; echo "PASS: adds"'
+commit "$tmp/r7" base; b=$(git -C "$tmp/r7" rev-parse HEAD)
+put "$tmp/r7" lib.sh "$LIB_GOOD"; commit "$tmp/r7" task
+writeplan "$tmp/r7" "$b" "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: adds"
+vt "$tmp/r7/plan.md"
+chk "trees: duplicate name is ambiguous" "$rc:$(labels "$out")" "1:ambiguous	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+# x: red with a ( detail before, green after. x2: never printed. "exit 0": only a longer pass line.
+newrepo "$tmp/r8"
+put "$tmp/r8" lib.sh "$LIB_BAD"
+put "$tmp/r8" t/demo.test.sh '. ./lib.sh
+if [ "$(add 1 2)" = 3 ]; then echo "PASS: x"; else echo "  FAIL: x (expected [1] got [2])"; fi
+echo "PASS: exit 0 with charter"'
+commit "$tmp/r8" base; b=$(git -C "$tmp/r8" rev-parse HEAD)
+put "$tmp/r8" lib.sh "$LIB_GOOD"; commit "$tmp/r8" task
+writeplan "$tmp/r8" "$b" "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: x
+t/demo.test.sh :: x2
+t/demo.test.sh :: exit 0"
+vt "$tmp/r8/plan.md"
+chk "trees: fail line with ( detail matches" "$rc:$(labels "$out")" "1:ok	t/demo.test.sh	x
+not-green	t/demo.test.sh	x2
+not-green	t/demo.test.sh	exit 0
+verify-tests: T1: 1 ok, 2 failed"
+
+newrepo "$tmp/r9"
+put "$tmp/r9" lib.sh "$LIB_BAD"
+put "$tmp/r9" t/demo.test.sh '. ./lib.sh
+if [ "$(add 1 2)" = 3 ]; then echo "ok - adds"; else echo "not ok - adds"; fi
+echo "PASS: adds"'
+commit "$tmp/r9" base; b=$(git -C "$tmp/r9" rev-parse HEAD)
+put "$tmp/r9" lib.sh "$LIB_GOOD"; commit "$tmp/r9" task
+writeplan "$tmp/r9" "$b" "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: adds" 'test_command: sh {file}
+test_pass_prefix: "ok - "
+test_fail_prefix: "not ok - "'
+vt "$tmp/r9/plan.md"
+chk "trees: custom command and prefixes" "$rc:$(labels "$out")" "0:ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+newrepo "$tmp/r10"
+put "$tmp/r10" lib.sh "$LIB_BAD"
+put "$tmp/r10" "t/it's a.test.sh" "$SUITE_ADDS"
+commit "$tmp/r10" base; b=$(git -C "$tmp/r10" rev-parse HEAD)
+put "$tmp/r10" lib.sh "$LIB_GOOD"; commit "$tmp/r10" task
+writeplan "$tmp/r10" "$b" "lib.sh
+t/it's a.test.sh" "t/it's a.test.sh :: adds"
+vt "$tmp/r10/plan.md"
+chk "trees: file with a space and a quote" "$rc:$(labels "$out")" "0:ok	t/it's a.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+mk "$tmp/r11" "$LIB_BAD" 'add() { echo 4; }'
+put "$tmp/r11" lib.sh "$LIB_GOOD"
+vt "$tmp/r11/plan.md"
+chk "trees: uncommitted change is ignored" "$rc:$(labels "$out")" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+newrepo "$tmp/r12"
+put "$tmp/r12" t/demo.test.sh 'if [ -f new.sh ]; then echo "PASS: has new"; else echo "FAIL: has new (new.sh missing)"; fi'
+commit "$tmp/r12" base; b=$(git -C "$tmp/r12" rev-parse HEAD)
+put "$tmp/r12" new.sh 'true'; commit "$tmp/r12" task
+writeplan "$tmp/r12" "$b" "new.sh
+t/demo.test.sh" "t/demo.test.sh :: has new"
+vt "$tmp/r12/plan.md"
+chk "trees: before tree deletes a path new since base" "$rc:$(labels "$out")" "0:ok	t/demo.test.sh	has new
+verify-tests: T1: 1 ok, 0 failed"
+
+# The suite prints a then b; tests: lists b first.
+newrepo "$tmp/r13"
+put "$tmp/r13" lib.sh "$LIB_BAD"
+put "$tmp/r13" t/demo.test.sh '. ./lib.sh
+if [ "$(add 1 2)" = 3 ]; then echo "PASS: a"; echo "PASS: b"; else echo "FAIL: a"; echo "FAIL: b"; fi'
+commit "$tmp/r13" base; b=$(git -C "$tmp/r13" rev-parse HEAD)
