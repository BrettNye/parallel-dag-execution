+st0="$(git -C "$tmp/r15" status --porcelain)"; h0="$(git -C "$tmp/r15" rev-parse HEAD)"
+p0="$(cksum < "$tmp/r15/plan.md")"
+vt "$tmp/r15/plan.md"; rc1=$rc
+st1="$(git -C "$tmp/r15" status --porcelain)"; h1="$(git -C "$tmp/r15" rev-parse HEAD)"
+p1="$(cksum < "$tmp/r15/plan.md")"
+chk "trees: shared tree untouched" "$rc1|$st1|$h1|$p1" "0|$st0|$h0|$p0"
+vt "$tmp/r3/plan.md"; rc2=$rc
+chk "trees: no worktree or temp dir left" "$rc1$rc2:$(wtcount "$tmp/r15"):$(wtcount "$tmp/r3"):$(ls -A "$tt")" "01:1:1:"
+
+echo
+echo "T8: signals"
+# waitfor <file>: poll until <file> exists, while the process $pid is alive (at most about 60 s).
+waitfor() { n=0; while [ ! -f "$1" ] && kill -0 "$pid" 2>/dev/null && [ "$n" -lt 600 ]; do sleep 0.1; n=$((n+1)); done; }
+started() { [ -f "$tmp/mark" ] && echo started; }
+# go <repo> <shell> [hook]: start verify-tests in the background, in its own process group
+# (so INT is not ignored), and wait for its suite to start; sets pid.
+go() {
+  rm -f "$tmp/mark" "$tmp/mark2"
+  set -m
+  VT_MARK="$tmp/mark" VERIFY_TESTS_CLEANUP_HOOK="${3:-}" TMPDIR="$tt" \
+    $2 "$SCRIPT" "$1/plan.md" T1 >"$tmp/so" 2>"$tmp/se" & pid=$!
+  set +m
+  waitfor "$tmp/mark"
+}
+mk "$tmp/r16" "$LIB_BAD" "$LIB_GOOD"
+# sigcase <signal> <shell> <name>: signal a run mid-suite; it exits 2, says so, and leaves nothing.
+sigcase() {
+  go "$tmp/r16" "$2"
+  kill -"$1" "$pid"; wait "$pid"; rc=$?
+  chk "$3 ($2)" "$(started):$rc:$(cat "$tmp/so"):$(wtcount "$tmp/r16"):$(ls -A "$tt")" "started:2::1:"
+  has "$3 ($2, stderr)" "$(cat "$tmp/se")" "verify-tests: T1: interrupted"
+}
+for shell in sh $ALTSH; do
+  sigcase TERM "$shell" "signals: TERM mid-run cleans up"
+  sigcase INT "$shell" "signals: INT mid-run cleans up"
+  sigcase HUP "$shell" "signals: HUP mid-run cleans up"
+  go "$tmp/r16" "$shell" 'touch "$VT_MARK"2; sleep 2'
+  kill -TERM "$pid"
+  waitfor "$tmp/mark2"
+  kill -TERM "$pid"; wait "$pid"; rc=$?
+  chk "signals: second signal during cleanup still exits 2 ($shell)" \
+    "$([ -f "$tmp/mark2" ] && echo hooked):$rc:$(wtcount "$tmp/r16"):$(ls -A "$tt")" "hooked:2:1:"
+done
+
+# KILL: its own TMPDIR, so the leak stays out of $tt.
+kt="$tmp/kt"; mkdir -p "$kt"
+rm -f "$tmp/mark"
+set -m
+VT_MARK="$tmp/mark" TMPDIR="$kt" sh "$SCRIPT" "$tmp/r16/plan.md" T1 >/dev/null 2>&1 & pid=$!
+set +m
+waitfor "$tmp/mark"
+kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid"; wait "$pid" 2>/dev/null
+leak1="$(wtcount "$tmp/r16")"
+rm -rf "$kt"/*      # the OS temp reaper
+vt "$tmp/r16/plan.md"
+chk "signals: KILL leaves a registration the next run prunes" "$leak1:$rc:$(wtcount "$tmp/r16")" "3:0:1"
+
+echo
+echo "T9: cleanup failure"
+mk "$tmp/r17" "$LIB_BAD" "$LIB_GOOD"
+out="$(VERIFY_TESTS_CLEANUP_HOOK='rm -f "$1/after/.git"' TMPDIR="$tt" sh "$SCRIPT" "$tmp/r17/plan.md" T1 2>"$tmp/e")"; rc=$?
+printf '%s\n' "$out" >> "$tmp/allout"
+git -C "$tmp/r17" worktree prune
+chk "cleanup: failed removal exits 2" "$rc:$(wtcount "$tmp/r17"):$(ls -A "$tt")" "2:1:"
+has "cleanup: failed removal exits 2 (stderr)" "$(cat "$tmp/e")" "verify-tests: T1: cleanup failed"
+
+echo
+echo "T10: stdout"
+stray="$(rg -v '^(--- .+ \((before|after)\)|  \| .*|(ok|ok-absent|not-red|not-green|ambiguous)\t[^\t]+\t.+|verify-tests: T1: [0-9]+ ok, [0-9]+ failed|)$' "$tmp/allout")"
+chk "trees: git stdout never reaches stdout" "$stray" ""
+
+echo
+echo "RESULT: $passes passed, $fails failed"
+[ "$fails" -eq 0 ]
