index 0000000..59b8463
--- /dev/null
+++ b/skills/executing-dag-plans/verify-tests
@@ -0,0 +1,181 @@
+#!/usr/bin/env sh
+# verify-tests — check that a task's named test cases were red before its change and green after.
+# Usage: verify-tests <plan> <id>
+# Exit: 0 every entry ok, or no entries; 1 at least one entry failed;
+#       2 usage, plan-state tests error, no base_sha, git failure, interrupt, or cleanup failure.
+# It never writes to the plan, touches the shared working tree or index, or commits.
+#
+# It builds two detached worktrees of HEAD under a mktemp -d directory: "after" as committed,
+# and "before", where every task file that is not a named test file is put back to base_sha
+# (or deleted when it did not exist there). Each test file runs once per tree; each entry is
+# labelled ambiguous, not-green, not-red, ok-absent or ok, and printed as
+# "<label><TAB><file><TAB><case>", then "verify-tests: <id>: <n> ok, <m> failed".
+# After the total line it prints the last 20 lines of the runs that explain the labels.
+# Both worktrees and the temporary directory are removed on every exit path, including
+# INT, TERM and HUP. A KILL leaks them; the next run's "git worktree prune" drops the
+# registration once the directory is gone. It never removes a worktree it did not create.
+# Untracked files: only committed files are in the trees; untracked and ignored files in
+#   the shared working tree are not. On this repository (2026-11-17) a run of the plan-state
+#   suite entry "round on "2" writes review_rounds: 3" with base_sha 76ed77d^ labelled it ok
+#   and exited 0: the repo's own suites need nothing untracked. Wall time: 400 s (two
+#   plan-state suite runs, Windows, Git Bash).
+# Bash tool timeout: on 2026-11-17 the Claude Code Bash tool, at a 5000 ms timeout, sent no
+#   signal: the log stayed empty, and the command was moved to the background and ran to its
+#   end. Probe: sh -c 'trap "echo INT >> /tmp/vt-probe.log; exit 2" INT; trap "echo TERM >>
+#   /tmp/vt-probe.log; exit 2" TERM; trap "echo HUP >> /tmp/vt-probe.log; exit 2" HUP;
+#   sleep 60 & wait' run with timeout: 5000, then read /tmp/vt-probe.log.
+# Test hook: VERIFY_TESTS_CLEANUP_HOOK, when set, runs as sh -c with $1 the temporary
+#   directory at the start of cleanup. Only the test suite sets it.
+set -u
+usage() { sed -n '3,5p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
+[ "$#" -eq 2 ] || usage
+plan=$1; id=$2
+here=$(cd "$(dirname -- "$0")" && pwd)
+ps="$here/../writing-dag-plans/plan-state"
+work=$(mktemp -d) || exit 2
+repo=""; child=""; cmd=""
+
+# Step 9. Returns non-zero, and says so, when anything is left behind.
+cleanup() {
+  [ -n "${VERIFY_TESTS_CLEANUP_HOOK:-}" ] && sh -c "$VERIFY_TESTS_CLEANUP_HOOK" sh "$work"
+  crc=0
+  if [ -n "$repo" ]; then
+    for w in "$work/after" "$work/before"; do
+      if [ -d "$w" ]; then git -C "$repo" worktree remove --force "$w" >/dev/null 2>&1 || crc=1; fi
+    done
+  fi
+  rm -rf "$work" 2>/dev/null || crc=1
+  [ -e "$work" ] && crc=1
+  [ "$crc" -eq 0 ] || echo "verify-tests: $id: cleanup failed" >&2
+  return "$crc"
+}
+# Clean up and exit with $1; a failed cleanup makes it 2.
+finish() { cleanup || exit 2; exit "$1"; }
+fault() { echo "verify-tests: $id: $1" >&2; finish 2; }
+on_signal() {
+  trap '' INT TERM HUP
+  if [ -n "$child" ]; then kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; fi
+  cleanup
+  echo "verify-tests: $id: interrupted" >&2
+  exit 2
+}
+trap on_signal INT TERM HUP
+
+rec="$work/rec"; perr="$work/err"
+if ! sh "$ps" tests "$plan" "$id" > "$rec" 2> "$perr"; then cat "$perr" >&2; finish 2; fi
+base=""; ntest=0
+while IFS= read -r line; do
+  case $line in
+    "base "*) base=${line#base } ;;
+    "command "*) cmd=${line#command } ;;
+    "test "*) ntest=$((ntest + 1)) ;;
+  esac
+done < "$rec"
+if [ "$ntest" -eq 0 ]; then echo "verify-tests: $id: no named tests"; finish 0; fi
+if [ "$base" = "-" ]; then fault "no base_sha (set the task running first)"; fi
+
+# Step 4.
+repo=$(git -C "$(dirname -- "$plan")" rev-parse --show-toplevel 2>/dev/null) || { repo=""; fault "not in a git repository"; }
+git -C "$repo" worktree prune >/dev/null 2>&1
+head=$(git -C "$repo" rev-parse --verify -q "HEAD^{commit}" 2>/dev/null) || fault "cannot read HEAD"
+git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || fault "base_sha $base is not a commit"
+
+# Steps 5 and 6.
+git -C "$repo" worktree add --detach "$work/after" "$head" >&2 || fault "cannot create the after tree"
+git -C "$repo" worktree add --detach "$work/before" "$head" >&2 || fault "cannot create the before tree"
