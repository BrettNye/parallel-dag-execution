+t/demo.test.sh" "t/demo.test.sh :: b
+t/demo.test.sh :: a"
+vt "$tmp/r13/plan.md"
+chk "trees: two entries keep tests: order" "$rc:$(labels "$out")" "0:ok	t/demo.test.sh	b
+ok	t/demo.test.sh	a
+verify-tests: T1: 2 ok, 0 failed"
+chk "tails: all ok prints no block" "$(printf '%s\n' "$out" | awk '/^---/{n++} END{print n+0}'):$out" "0:ok	t/demo.test.sh	b
+ok	t/demo.test.sh	a
+verify-tests: T1: 2 ok, 0 failed"
+
+writeplan "$tmp/r1" 0000000 "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: adds"
+vt "$tmp/r1/plan.md"
