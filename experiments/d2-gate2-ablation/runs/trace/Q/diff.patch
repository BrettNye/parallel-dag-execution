+SCRIPT="$REPO/skills/executing-dag-plans/verify-tests"
+[ -f "$SCRIPT" ] || { echo "FAIL: verify-tests not found at $SCRIPT" >&2; exit 1; }
+command -v rg >/dev/null 2>&1 || { echo "tests need rg (ripgrep)" >&2; exit 2; }
+if command -v dash >/dev/null 2>&1; then ALTSH=dash; else ALTSH=sh; echo "NOTE: dash not installed - alt-shell cases run under sh"; fi
+fails=0; passes=0
+ok()   { passes=$((passes+1)); echo "  PASS: $1"; }
+bad()  { fails=$((fails+1));  echo "  FAIL: $1"; }
+chk()  { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1 (expected [$3] got [$2])"; fi; }
+has()  { if printf '%s\n' "$2" | rg -qF -- "$3"; then ok "$1"; else bad "$1 (missing [$3] in: $2)"; fi; }
+hasnt(){ if printf '%s\n' "$2" | rg -qF -- "$3"; then bad "$1 (unexpected [$3] in: $2)"; else ok "$1"; fi; }
+
+# Fixtures live under the system temp dir; GIT_CEILING_DIRECTORIES keeps any enclosing repo out.
+tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
+export GIT_CEILING_DIRECTORIES="$(dirname "$tmp")"
+if git -C "$tmp" rev-parse --show-toplevel >/dev/null 2>&1; then bad "fixture: $tmp is inside a repository"; fi
+
+# mkplan FILE [EXTRA-YAML-LINES...]: one task, task-a, with files t/a.sh.
+mkplan() {
+  f="$1"; shift
+  { echo "---"; echo "title: demo"; echo "---"; echo
+    printf '%s\n' '```mermaid' 'flowchart TD' '    stale["stale"]' '```' '' '## Task: only' '' '```yaml' 'id: task-a' 'depends_on: []' 'files:' '  - t/a.sh' 'status: pending'
+    [ $# -gt 0 ] && printf '%s\n' "$@"
+    printf '%s\n' '```'; } > "$f"
+}
+mkplan "$tmp/notests.md"
+mkplan "$tmp/nobase.md" "tests:" "  - t/a.sh :: one"
+
+# runall SHELL: exit codes of the usage (0, 1 and 3 args), unreadable-plan, unknown-id, no-tests and no-base cases, joined by commas.
+runall() {
+  sh_="$1"; r=""
+  "$sh_" "$SCRIPT" >/dev/null 2>&1; r="$r$?,"
+  "$sh_" "$SCRIPT" x >/dev/null 2>&1; r="$r$?,"
+  "$sh_" "$SCRIPT" x y z >/dev/null 2>&1; r="$r$?,"
+  "$sh_" "$SCRIPT" "$tmp/missing.md" task-a >/dev/null 2>&1; r="$r$?,"
+  "$sh_" "$SCRIPT" "$tmp/notests.md" zz >/dev/null 2>&1; r="$r$?,"
+  "$sh_" "$SCRIPT" "$tmp/notests.md" task-a >/dev/null 2>&1; r="$r$?,"
+  "$sh_" "$SCRIPT" "$tmp/nobase.md" task-a >/dev/null 2>&1; r="$r$?"
+  printf '%s' "$r"
+}
+
+echo "T1: argument handling"
+obs=""
+for set in "" "x" "x y z"; do
+  out="$(sh "$SCRIPT" $set 2>"$tmp/e")"; rc=$?
+  obs="$obs[$rc:$out:$(rg -cF 'verify-tests <plan> <id>' "$tmp/e")]"
+done
+chk "args: no arguments is usage" "$obs" "[2::1][2::1][2::1]"
+
+out="$(sh "$SCRIPT" "$tmp/notests.md" zz 2>"$tmp/e")"; rc=$?
+has "args: plan-state error is relayed" "$rc:$out:$(cat "$tmp/e")" "2::plan-state: no task with id zz"
+out="$(sh "$SCRIPT" "$tmp/missing.md" task-a 2>"$tmp/e")"; rc=$?
+has "args: unreadable plan is relayed" "$rc:$out:$(cat "$tmp/e")" "2::plan-state: cannot read"
+
+out="$(sh "$SCRIPT" "$tmp/notests.md" task-a 2>"$tmp/e")"; rc=$?
+chk "args: no named tests exits 0" "$rc:$out" "0:verify-tests: task-a: no named tests"
+
+out="$(sh "$SCRIPT" "$tmp/nobase.md" task-a 2>"$tmp/e")"; rc=$?
+chk "args: no base_sha exits 2" "$rc:$out:$(cat "$tmp/e")" "2::verify-tests: task-a: no base_sha (set the task running first)"
+
+chk "args: runs under dash" "$(runall "$ALTSH")" "2,2,2,2,2,0,2"
+
+# ---- Trees: fixtures are fresh repositories under $tmp; verify-tests' own temp dirs go under $TMPDIR.
+PS="$REPO/skills/writing-dag-plans/plan-state"
+export TMPDIR="$tmp/vtmp"; mkdir -p "$TMPDIR"
+TAB="$(printf '\t')"
+gi()  { git init -q "$1" && git -C "$1" config user.email t@t && git -C "$1" config user.name t && git -C "$1" config core.autocrlf false; }
+put() { mkdir -p "$(dirname -- "$1/$2")" && printf '%s\n' "$3" > "$1/$2"; }
+cm()  { git -C "$1" add -A && git -C "$1" commit -q -m "$2"; }
+# wplan DIR [YAML-LINES...]: plan.md whose one task T1 gets the given lines; $FM adds front-matter lines.
+wplan() {
+  d_="$1"; shift
+  { echo "---"; echo "title: demo"; [ -n "${FM:-}" ] && printf '%s\n' "$FM"; echo "---"; echo
+    printf '%s\n' '```mermaid' 'flowchart TD' '    T1["T1"]' '```' '' '## Task: one' '' '```yaml' 'id: T1' 'depends_on: []'
+    printf '%s\n' "$@"; echo 'status: pending'; printf '%s\n' '```'; } > "$d_/plan.md"
+}
+start() { sh "$PS" set "$1/plan.md" T1 ready >/dev/null && sh "$PS" set "$1/plan.md" T1 running >/dev/null; }
+# DEMO: case "adds" passes once lib.sh says v=new. With VT_MARK set it writes its pid there and sleeps.
+DEMO='if [ -n "${VT_MARK:-}" ]; then echo $$ > "$VT_MARK"; exec sleep 30; fi
+. ./lib.sh
+if [ "$v" = new ]; then echo "PASS: adds"; else echo "FAIL: adds (v=$v)"; fi'
+STD=('files:' '  - lib.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: adds')
+# mkrepo DIR [SUITE]: lib.sh goes from v=old to v=new in T1's commit; T1 tests t/demo.test.sh :: adds.
+mkrepo() {
+  gi "$1"; put "$1" lib.sh 'v=old'; put "$1" t/demo.test.sh "${2:-$DEMO}"
+  wplan "$1" "${STD[@]}"; cm "$1" base; start "$1"; put "$1" lib.sh 'v=new'; cm "$1" T1
+}
+# vt ARGS: run verify-tests; sets out and rc, leaves stderr in $tmp/e, and keeps every stdout in $tmp/allout.
+: > "$tmp/allout"
+vt() { out="$(sh "$SCRIPT" "$@" 2>"$tmp/e")"; rc=$?; printf '%s\n' "$out" >> "$tmp/allout"; }
+wtn() { git -C "$1" worktree list | wc -l | tr -d ' '; }
+left() { ls -A "$TMPDIR" | wc -l | tr -d ' '; }
+
+echo "T2: before and after trees"
+mkrepo "$tmp/r1"
+vt "$tmp/r1/plan.md" T1
+chk "trees: red then green is ok" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+d="$tmp/r2"; gi "$d"
+put "$d" t/demo.test.sh '[ -f new.sh ] || exit 1
+. ./new.sh
+echo "PASS: made"'
+wplan "$d" 'files:' '  - new.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: made'
+cm "$d" base; start "$d"; put "$d" new.sh 'x=1'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: absent before is ok-absent" "$rc:$out" "0:ok-absent${TAB}t/demo.test.sh${TAB}made
+verify-tests: T1: 1 ok, 0 failed
+--- t/demo.test.sh (before)
+  | (no output)"
+
+mkrepo "$tmp/r3" 'echo "PASS: adds"'
+vt "$tmp/r3/plan.md" T1
+chk "trees: passing before is not-red" "$rc:$out" "1:not-red${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (before)
+  | PASS: adds"
+
+d="$tmp/r4"; gi "$d"; put "$d" lib.sh 'v=old'; put "$d" t/demo.test.sh 'echo "PASS: x"'
+wplan "$d" 'files:' '  - lib.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: y'
+cm "$d" base; start "$d"; put "$d" t/demo.test.sh 'echo "PASS: x"
+echo "PASS: y"'; put "$d" lib.sh 'v=new'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: new case passing on old code is not-red" "$rc:$out" "1:not-red${TAB}t/demo.test.sh${TAB}y
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (before)
+  | PASS: x
+  | PASS: y"
+
+d="$tmp/r5"; gi "$d"; put "$d" lib.sh 'v=old'
+wplan "$d" 'files:' '  - lib.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: y'
+cm "$d" base; start "$d"; put "$d" t/demo.test.sh 'echo "PASS: y"'; put "$d" lib.sh 'v=new'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: new suite file is kept in the before tree" "$rc:$out" "1:not-red${TAB}t/demo.test.sh${TAB}y
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (before)
+  | PASS: y"
+
+mkrepo "$tmp/r6" 'echo "FAIL: adds (never)"'
+vt "$tmp/r6/plan.md" T1
+chk "trees: failing after is not-green" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (after)
+  | FAIL: adds (never)"
+
+mkrepo "$tmp/r7" '. ./lib.sh
+if [ "$v" = old ]; then echo "PASS: adds"; else echo "FAIL: adds (v=$v)"; fi'
+vt "$tmp/r7/plan.md" T1
+chk "trees: not-green wins over not-red" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (after)
+  | FAIL: adds (v=new)"
+
+mkrepo "$tmp/r8" '. ./lib.sh
+echo "PASS: adds"
+[ "$v" = new ] && echo "  PASS: adds  "'
+vt "$tmp/r8/plan.md" T1
+chk "trees: duplicate name is ambiguous" "$rc:$out" "1:ambiguous${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (after)
+  | PASS: adds
+  |   PASS: adds  "
+
+# Before: x fails with detail, and "exit 0" has only the longer line. After: x, x2 and "exit 0" pass
+# (CRLF endings), and the longer line is still printed. A bare prefix match would make x2 failed
+# before (ok, not ok-absent) and "exit 0" ambiguous after.
+d="$tmp/r9"; gi "$d"; put "$d" lib.sh 'v=old'
+put "$d" t/demo.test.sh '. ./lib.sh
+echo "PASS: exit 0 with charter"
+if [ "$v" = new ]; then printf "%s\r\n" "PASS: x" "PASS: x2" "PASS: exit 0"; else echo "  FAIL: x (expected [1] got [2])"; fi'
+wplan "$d" 'files:' '  - lib.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: x' '  - t/demo.test.sh :: x2' '  - t/demo.test.sh :: exit 0'
+cm "$d" base; start "$d"; put "$d" lib.sh 'v=new'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: fail line with ( detail matches" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}x
+ok-absent${TAB}t/demo.test.sh${TAB}x2
+ok-absent${TAB}t/demo.test.sh${TAB}exit 0
+verify-tests: T1: 3 ok, 0 failed
+--- t/demo.test.sh (before)
+  | PASS: exit 0 with charter
+  |   FAIL: x (expected [1] got [2])"
+
+# The suite prints a second pass line unless the custom command set VT_VIA, so "bash {file}" would make it ambiguous.
+FM='test_command: VT_VIA=custom sh {file}
+test_pass_prefix: "ok - "
+test_fail_prefix: "not ok - "'
+mkrepo "$tmp/r10" '. ./lib.sh
+[ "${VT_VIA:-}" = custom ] || echo "ok - adds"
+if [ "$v" = new ]; then echo "ok - adds"; else echo "not ok - adds"; fi'
+FM=""
+vt "$tmp/r10/plan.md" T1
+chk "trees: custom command and prefixes" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+d="$tmp/r11"; gi "$d"; put "$d" lib.sh 'v=old'; put "$d" "t/it's a.test.sh" "$DEMO"
+wplan "$d" 'files:' '  - lib.sh' "  - t/it's a.test.sh" 'tests:' "  - t/it's a.test.sh :: adds"
+cm "$d" base; start "$d"; put "$d" lib.sh 'v=new'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: file with a space and a quote" "$rc:$out" "0:ok${TAB}t/it's a.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+d="$tmp/r12"; gi "$d"; put "$d" lib.sh 'v=old'; put "$d" t/demo.test.sh "$DEMO"
+wplan "$d" "${STD[@]}"; cm "$d" base; start "$d"; put "$d" other.txt 'T1 work'; cm "$d" T1
+put "$d" lib.sh 'v=new'
+vt "$d/plan.md" T1
+chk "trees: uncommitted change is ignored" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (after)
+  | FAIL: adds (v=old)"
+
+d="$tmp/r13"; gi "$d"
+put "$d" t/demo.test.sh 'if [ -f extra.sh ]; then echo "PASS: adds"; else echo "FAIL: adds (no extra.sh)"; fi'
+wplan "$d" 'files:' '  - extra.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: adds'
+cm "$d" base; start "$d"; put "$d" extra.sh 'x=1'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: before tree deletes a path new since base" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed"
+
+d="$tmp/r14"; gi "$d"; put "$d" lib.sh 'v=old'
+put "$d" t/demo.test.sh '. ./lib.sh
+for c in a b; do if [ "$v" = new ]; then echo "PASS: $c"; else echo "FAIL: $c"; fi; done'
+wplan "$d" 'files:' '  - lib.sh' '  - t/demo.test.sh' 'tests:' '  - t/demo.test.sh :: b' '  - t/demo.test.sh :: a'
+cm "$d" base; start "$d"; put "$d" lib.sh 'v=new'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "trees: two entries keep tests: order" "$rc:$out" "0:ok${TAB}t/demo.test.sh${TAB}b
+ok${TAB}t/demo.test.sh${TAB}a
+verify-tests: T1: 2 ok, 0 failed"
+
+d="$tmp/r15"; gi "$d"; put "$d" lib.sh 'v=old'; put "$d" t/demo.test.sh "$DEMO"
+wplan "$d" "${STD[@]}" 'base_sha: 0000000'; cm "$d" base
+vt "$d/plan.md" T1
+chk "trees: base_sha not a commit" "$rc:$out:$(rg -c 'is not a commit' "$tmp/e")" "2::1"
+
+obs=""
+for r in r1 r3; do vt "$tmp/$r/plan.md" T1; obs="$obs[$rc:$(wtn "$tmp/$r"):$(left)]"; done
+chk "trees: no worktree or temp dir left" "$obs" "[0:1:0][1:1:0]"
+
+d="$tmp/r16"; mkrepo "$d"; put "$d" lib.sh 'v=dirty'; put "$d" scratch.txt 'untracked'
+b_st="$(git -C "$d" status --porcelain)"; b_plan="$(cksum < "$d/plan.md")"; b_head="$(git -C "$d" rev-parse HEAD)"
+vt "$d/plan.md" T1
+chk "trees: shared tree untouched" "$rc|$(git -C "$d" status --porcelain)|$(cksum < "$d/plan.md")|$(git -C "$d" rev-parse HEAD)" "0|$b_st|$b_plan|$b_head"
+
+d="$tmp/r17"; gi "$d"; put "$d" .gitignore 'secret.sh'; put "$d" lib.sh 'v=old'
+put "$d" t/demo.test.sh 'if [ -f secret.sh ]; then . ./secret.sh; echo "PASS: adds"; else echo "FAIL: adds (no secret.sh)"; fi'
+wplan "$d" "${STD[@]}"; cm "$d" base; start "$d"; put "$d" lib.sh 'v=new'; cm "$d" T1; put "$d" secret.sh 'k=1'
+vt "$d/plan.md" T1
+chk "trees: ignored dependency is not in the after tree" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 0 ok, 1 failed
+--- t/demo.test.sh (after)
+  | FAIL: adds (no secret.sh)"
+
+echo "T3: signals and cleanup"
+mkrepo "$tmp/rs"
+# sigrun SHELL SIGNAL [SECOND]: run verify-tests on rs under SHELL and send SIGNAL once the suite runs,
+# then SECOND once $tmp/mark2 exists (the cleanup hook writes it). Prints
+# "[shell rc:stdout:interrupted-lines:worktrees:temp-entries:fast]"; fast is 1 when the 30 s suite did not run out.
+sigrun() {
+  rm -f "$tmp/mark" "$tmp/mark2"; t0=$SECONDS
+  set -m
+  VT_MARK="$tmp/mark" "$1" "$SCRIPT" "$tmp/rs/plan.md" T1 >"$tmp/so" 2>"$tmp/se" & p=$!
+  set +m
+  while [ ! -s "$tmp/mark" ] && [ $((SECONDS - t0)) -lt 20 ]; do sleep 0.2; done
+  kill -s "$2" "$p"
+  if [ -n "${3:-}" ]; then
+    while [ ! -s "$tmp/mark2" ] && [ $((SECONDS - t0)) -lt 20 ]; do sleep 0.2; done
+    kill -s "$3" "$p"
+  fi
+  wait "$p"; r=$?
+  cat "$tmp/so" >> "$tmp/allout"
+  fast=0; [ $((SECONDS - t0)) -lt 25 ] && fast=1
+  printf '[%s %s:%s:%s:%s:%s:%s]' "$1" "$r" "$(cat "$tmp/so")" "$(rg -c 'verify-tests: T1: interrupted' "$tmp/se")" "$(wtn "$tmp/rs")" "$(left)" "$fast"
+}
+want() { printf '[sh %s][%s %s]' "$1" "$ALTSH" "$1"; }
+for s in TERM INT HUP; do
+  chk "signals: $s mid-run cleans up" "$(sigrun sh $s)$(sigrun "$ALTSH" $s)" "$(want "2::1:1:0:1")"
+done
+
+# The cleanup hook writes mark2 and then sleeps, so the second TERM lands while the trap cleans up.
+export VERIFY_TESTS_CLEANUP_HOOK="echo cleaning > '$tmp/mark2'; sleep 2"
+chk "signals: second signal during cleanup still exits 2" "$(sigrun sh TERM TERM)$(sigrun "$ALTSH" TERM TERM)" "$(want "2::1:1:0:1")"
+unset VERIFY_TESTS_CLEANUP_HOOK
+
+# killrun SHELL: KILL a running verify-tests under its own TMPDIR, stop the orphaned suite and delete
+# the leaked temp dir as the OS would, then run again. Prints "[shell worktrees-after-kill:rerun-ok:worktrees]".
+killrun() (
+  export TMPDIR="$tmp/ktmp"; rm -rf "$TMPDIR"; mkdir -p "$TMPDIR"; rm -f "$tmp/mark"; t0=$SECONDS
+  VT_MARK="$tmp/mark" "$1" "$SCRIPT" "$tmp/rs/plan.md" T1 >"$tmp/so" 2>"$tmp/se" & p=$!
+  while [ ! -s "$tmp/mark" ] && [ $((SECONDS - t0)) -lt 20 ]; do sleep 0.2; done
+  kill -s KILL "$p"; wait "$p" 2>/dev/null
+  kill "$(cat "$tmp/mark")" 2>/dev/null; sleep 1
+  n1="$(wtn "$tmp/rs")"
+  rm -rf "$TMPDIR"/*
+  "$1" "$SCRIPT" "$tmp/rs/plan.md" T1 >"$tmp/so" 2>"$tmp/se"; r=$?
+  cat "$tmp/so" >> "$tmp/allout"
+  rok=0; { [ "$r" -eq 0 ] || [ "$r" -eq 1 ]; } && rok=1
+  printf '[%s %s:%s:%s]' "$1" "$n1" "$rok" "$(wtn "$tmp/rs")"
+)
+chk "signals: KILL leaves a registration the next run prunes" "$(killrun sh)$(killrun "$ALTSH")" "[sh 3:1:1][$ALTSH 3:1:1]"
+
+# The hook deletes the after tree's .git file, so git refuses to remove that worktree.
+d="$tmp/r18"; mkrepo "$d"
+VERIFY_TESTS_CLEANUP_HOOK='rm -f "$1/after/.git"' vt "$d/plan.md" T1
+chk "cleanup: failed removal exits 2" "$rc:$out:$(rg -c 'verify-tests: T1: cleanup failed' "$tmp/e")" "2:ok${TAB}t/demo.test.sh${TAB}adds
+verify-tests: T1: 1 ok, 0 failed:1"
+git -C "$d" worktree prune
+
+echo "T4: tails"
+# Spec example: a.sh :: x is absent before and passes after; b.sh :: y fails after.
+d="$tmp/t1"; gi "$d"; put "$d" a.sh 'echo "note a"
+[ -f new.sh ] && echo "PASS: x"'; put "$d" b.sh 'echo "FAIL: y (boom)"'
+wplan "$d" 'files:' '  - new.sh' '  - a.sh' '  - b.sh' 'tests:' '  - a.sh :: x' '  - b.sh :: y'
+cm "$d" base; start "$d"; put "$d" new.sh 'x=1'; cm "$d" T1
+vt "$d/plan.md" T1
+chk "tails: spec example order" "$rc:$out" "1:ok-absent${TAB}a.sh${TAB}x
+not-green${TAB}b.sh${TAB}y
+verify-tests: T1: 1 ok, 1 failed
+--- a.sh (before)
+  | note a
+--- b.sh (after)
+  | FAIL: y (boom)"
+
+mkrepo "$tmp/t2" 'for i in $(seq 1 30); do echo "line $i"; done
+echo "FAIL: adds (end)"'
+vt "$tmp/t2/plan.md" T1
+body="$(printf '%s\n' "$out" | sed '1,/^--- /d')"
+chk "tails: last 20 lines only" "$(printf '%s\n' "$body" | wc -l | tr -d ' '):$(printf '%s\n' "$body" | rg -c '^  \| '):$(printf '%s\n' "$body" | head -n 1):$(printf '%s\n' "$body" | tail -n 1)" "20:20:  | line 12:  | FAIL: adds (end)"
+
+mkrepo "$tmp/t3" '. ./lib.sh
+if [ "$v" = old ]; then echo "PASS: adds"; else echo "FAIL: adds (v=$v)"; fi'
+vt "$tmp/t3/plan.md" T1
+chk "tails: not-red and not-green gives only after" "$(printf '%s\n' "$out" | rg '^---')" "--- t/demo.test.sh (after)"
+
+mkrepo "$tmp/t4" '. ./lib.sh
+echo "FAIL: x (v=$v)"
+[ "$v" = new ] && echo "PASS: y"
+echo done'
+put "$tmp/t4" plan.md "$(sed 's/  - t\/demo.test.sh :: adds/  - t\/demo.test.sh :: x\n  - t\/demo.test.sh :: y/' "$tmp/t4/plan.md")"
+vt "$tmp/t4/plan.md" T1
+chk "tails: one file gives after then before" "$rc:$out" "1:not-green${TAB}t/demo.test.sh${TAB}x
+ok-absent${TAB}t/demo.test.sh${TAB}y
+verify-tests: T1: 1 ok, 1 failed
+--- t/demo.test.sh (after)
+  | FAIL: x (v=new)
+  | PASS: y
+  | done
+--- t/demo.test.sh (before)
+  | FAIL: x (v=old)
+  | done"
+
