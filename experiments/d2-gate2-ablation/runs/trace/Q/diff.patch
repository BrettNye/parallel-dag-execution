@@ -0,0 +1,189 @@
+#!/usr/bin/env sh
+# verify-tests — check that a task's named test cases were red before its change and green after.
+# Usage: verify-tests <plan> <id>
+# Exit: 0 every entry ok, or no entries.
+#       1 at least one entry failed.
+#       2 usage, plan-state error, no base_sha, git failure, cleanup failure, or interrupt.
+# It never writes to the plan, touches the shared working tree or index, or commits.
+# It builds two detached worktrees of HEAD in a mktemp -d directory: "after" as committed, and
+# "before", where each of the task's files that is not one of its test files is put back to
+# base_sha (or deleted if base_sha lacks it). Each test file runs once in each tree, and each
+# tests: entry gets one label: ambiguous, not-green, not-red, ok-absent or ok.
+# Untracked files: only committed files are in the trees; untracked and ignored files of the
+#   shared working tree are not. On this repository (2026-11-18, Windows 11, Git Bash, a busy
+#   machine) a check of one plan-state.test.sh case, base_sha 76ed77d^, labelled it ok and exited
+#   0: the suite needed nothing untracked. Running the suite in both trees took 606 s.
+# Bash tool timeout: on 2026-11-18 the Claude Code Bash tool sent no signal when its timeout ran
+#   out; it moved the command to the background and let it finish, so the log stayed empty. Probe,
+#   run with timeout 5000: sh -c 'trap "echo INT >> /tmp/vt-probe.log; exit 2" INT; trap "echo
+#   TERM >> /tmp/vt-probe.log; exit 2" TERM; trap "echo HUP >> /tmp/vt-probe.log; exit 2" HUP;
+#   sleep 60 & wait'. A KILL leaves the temp dir and two worktree registrations; the next run's
+#   git worktree prune clears the registrations once the temp dir is gone.
+# VERIFY_TESTS_CLEANUP_HOOK is for tests only: when set, cleanup first runs it with
+#   sh -c "$VERIFY_TESTS_CLEANUP_HOOK" sh <temp dir>.
+set -u
+# Lines 3-6 of this file are the usage line and the three exit lines.
+usage() { sed -n '3,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
+[ "$#" -eq 2 ] || usage
+plan=$1; id=$2
+here=$(cd "$(dirname -- "$0")" && pwd)
+ps="$here/../writing-dag-plans/plan-state"
+work=$(mktemp -d) || exit 2
+rec="$work/rec"; perr="$work/err"
+if ! sh "$ps" tests "$plan" "$id" > "$rec" 2> "$perr"; then cat "$perr" >&2; rm -rf "$work"; exit 2; fi
+base=""; cmd=""; ntest=0
+while IFS= read -r line; do
+  case $line in
+    "base "*) base=${line#base } ;;
+    "command "*) cmd=${line#command } ;;
+    "test "*) ntest=$((ntest + 1)) ;;
+  esac
+done < "$rec"
+if [ "$ntest" -eq 0 ]; then echo "verify-tests: $id: no named tests"; rm -rf "$work"; exit 0; fi
+if [ "$base" = "-" ]; then echo "verify-tests: $id: no base_sha (set the task running first)" >&2; rm -rf "$work"; exit 2; fi
+
+fault() { echo "verify-tests: $id: $1" >&2; rm -rf "$work"; exit 2; }
+repo=$(git -C "$(dirname -- "$plan")" rev-parse --show-toplevel 2>/dev/null) || fault "not in a git repository"
+git -C "$repo" worktree prune >/dev/null 2>&1
+head=$(git -C "$repo" rev-parse --verify -q HEAD 2>/dev/null) || fault "cannot read HEAD"
+git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || fault "base_sha $base is not a commit"
+
+# Step 9: remove both worktrees and the temp dir; returns 1 when anything is left behind.
+cleanup() {
+  crc=0
+  if [ -n "${VERIFY_TESTS_CLEANUP_HOOK:-}" ]; then sh -c "$VERIFY_TESTS_CLEANUP_HOOK" sh "$work" >&2; fi
+  for w in after before; do
+    if [ -d "$work/$w" ]; then git -C "$repo" worktree remove --force "$work/$w" >/dev/null 2>&1 || crc=1; fi
+  done
+  rm -rf "$work" 2>/dev/null; [ -e "$work" ] && crc=1
+  return "$crc"
+}
+# Stops the running suite (its whole process group when the shell gave it one), cleans up, exits 2.
+# Further signals are ignored meanwhile, so the exit stays 2.
+child=""
+on_signal() {
+  trap '' INT TERM HUP
+  if [ -n "$child" ]; then
+    kill -s TERM -- "-$child" 2>/dev/null || kill -s TERM "$child" 2>/dev/null
+    wait "$child" 2>/dev/null
+  fi
+  cleanup || echo "verify-tests: $id: cleanup failed" >&2
+  echo "verify-tests: $id: interrupted" >&2
+  exit 2
+}
+trap on_signal INT TERM HUP
+bail() {
+  echo "verify-tests: $id: $1" >&2
+  trap '' INT TERM HUP
+  cleanup || echo "verify-tests: $id: cleanup failed" >&2
+  exit 2
+}
+
+# Distinct test files in tests: order, and the task's other files, which the before tree puts back.
+: > "$work/tfiles"; : > "$work/restore"
+awk -v W="$work" '
+  /^file / { fl[++n] = substr($0, 6) }
+  /^test / { s = substr($0, 6); f = substr(s, 1, index(s, "\t") - 1)
+             if (!(f in tf)) { tf[f] = 1; print f > (W "/tfiles") } }
+  END { for (i = 1; i <= n; i++) if (!(fl[i] in tf)) print fl[i] > (W "/restore") }' "$rec" ||
+  bail "cannot read the test record"
+
+git -C "$repo" worktree add --detach "$work/after" "$head" >&2 || bail "cannot add the after worktree"
+git -C "$repo" worktree add --detach "$work/before" "$head" >&2 || bail "cannot add the before worktree"
+while IFS= read -r p; do
