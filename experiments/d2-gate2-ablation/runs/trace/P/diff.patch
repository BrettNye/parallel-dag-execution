+sigrun sh HUP; chk "signals: HUP mid-run cleans up" "$sres" "2|1|1|[]"
+sigrun sh TERM TERM; chk "signals: second signal during cleanup still exits 2" "$sres" "2|1|1|[]"
+alt=""; for sg in TERM INT HUP "TERM TERM"; do sigrun $ALTSH $sg; alt="$alt$sres "; done
+chk "signals: under $ALTSH, TERM, INT, HUP and a second TERM clean up" "$alt" \
+  "2|1|1|[] 2|1|1|[] 2|1|1|[] 2|1|1|[] "
+
+# KILL cannot be trapped: the temp dir and the registration leak. Deleting the leaked dir stands
+# in for the OS temp reaper; the next run's git worktree prune then drops the registration.
+r="$tmp/rk"; kt="$tmp/kt"; std "$r"; mkdir -p "$kt"
+VT_MARK="$tmp/markk" VT_SLEEP=15 TMPDIR="$kt" sh "$SCRIPT" "$r/plan.md" T1 >/dev/null 2>&1 & p=$!
+wait_mark "$tmp/markk" "$p"; kill -KILL "$p"; wait "$p" 2>/dev/null
+leaked="$(wtn "$r")"
+rm -rf "$kt"/*
+TMPDIR="$kt" sh "$SCRIPT" "$r/plan.md" T1 >/dev/null 2>&1; rc=$?
+chk "signals: KILL leaves a registration the next run prunes" "$leaked $rc $(wtn "$r") [$(ls -A "$kt")]" "3 0 1 []"
+
+# Test-only fault: the suite locks its own worktree, so git worktree remove --force refuses it.
+r="$tmp/rc"; ct="$tmp/ct"; newrepo "$r"; put "$r" lib.sh "$LIB_BAD"
+put "$r" t/demo.test.sh "$SUITE"'
+git worktree lock --reason vt-test "$PWD" >/dev/null 2>&1'
+base=$(snap "$r" base); put "$r" lib.sh "$LIB_OK"; snap "$r" change >/dev/null
+wplan "$r" "$base" "lib.sh
+t/demo.test.sh" "t/demo.test.sh :: adds"
+mkdir -p "$ct"
+out="$(TMPDIR="$ct" sh "$SCRIPT" "$r/plan.md" T1 2>"$tmp/e")"; rc=$?
+chk "cleanup: failed removal exits 2" "$rc|$out|$(rg -cF "verify-tests: T1: cleanup failed" "$tmp/e")" "2|ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed|1"
+git -C "$r" worktree list --porcelain | sed -n 's/^worktree //p' | tail -n +2 | while IFS= read -r w; do
+  git -C "$r" worktree unlock "$w" 2>/dev/null; done
+git -C "$r" worktree prune
+
+echo "T5: output"
+printf '%s' "$allout" | rg -v '^$' | rg -v '^(ok|ok-absent|not-red|not-green|ambiguous)	[^	]+	.+$|^verify-tests: T1: [0-9]+ ok, [0-9]+ failed$|^--- .* \((after|before)\)$|^  \| ' > "$tmp/stray"
+chk "trees: git stdout never reaches stdout" "$(cat "$tmp/stray")|$([ -n "$allout" ] && echo some)" "|some"
+
+echo
+echo "RESULT: $passes passed, $fails failed"
+[ "$fails" -eq 0 ]
