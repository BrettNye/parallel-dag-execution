+# wait_mark FILE PID: wait up to 60 s for the suite to start, and stop early if PID has ended.
+wait_mark() { local i=0; while [ ! -e "$1" ] && [ "$i" -lt 300 ] && kill -0 "$2" 2>/dev/null; do sleep 0.2; i=$((i+1)); done; }
+# sigrun SHELL SIGNAL [SIGNAL2]: start verify-tests on a sleeping suite, send the signal(s) once the
