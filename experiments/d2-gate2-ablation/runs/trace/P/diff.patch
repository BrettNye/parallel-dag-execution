index 0000000..1145ac0
--- /dev/null
+++ b/skills/executing-dag-plans/verify-tests
@@ -0,0 +1,187 @@
+#!/usr/bin/env sh
+# verify-tests - check that a task's named test cases were red before its change and green after.
+# Usage: verify-tests <plan> <id>
+# Exit 0: every entry ok, or the task has no entries.
+# Exit 1: at least one entry failed.
+# Exit 2: usage, plan-state error, no base_sha, git failure, cleanup failure, or interrupt.
+# It never writes to the plan, touches the shared working tree or index, or commits.
+# The after tree is a detached worktree at HEAD; the before tree is another, with the task's
+# non-test files put back to base_sha. Each test file runs once per tree; each entry is labelled
+# ok, ok-absent, not-red, not-green or ambiguous.
+# Untracked files: only committed files are in the trees; untracked and git-ignored files in the
+#   shared working tree are not. On this repository (2026-11-18, Windows, Git Bash), a run for
+#   plan-state's "round on "2" writes review_rounds: 3" with base_sha 76ed77d^ printed ok and
+#   exited 0, so its suites need nothing untracked; wall time 1405 s (the plan-state suite twice,
+#   on a heavily loaded machine).
+# Bash tool timeout: on 2026-11-18 (Windows, Git Bash) the log stayed empty: a Claude Code Bash
+#   tool call with timeout 5000 sent no signal; it moved the command to the background, where it
+#   ran to its end. Probe: sh -c 'trap "echo INT >> /tmp/vt-probe.log; exit 2" INT;
+#   trap "echo TERM >> /tmp/vt-probe.log; exit 2" TERM; trap "echo HUP >> /tmp/vt-probe.log;
+#   exit 2" HUP; sleep 60 & wait'
+set -u
+usage() { sed -n '3,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
+[ "$#" -eq 2 ] || usage
+plan=$1; id=$2
+here=$(cd "$(dirname -- "$0")" && pwd)
+ps="$here/../writing-dag-plans/plan-state"
+work=$(mktemp -d) || exit 2
+rec="$work/rec"; perr="$work/err"
+if ! sh "$ps" tests "$plan" "$id" > "$rec" 2> "$perr"; then cat "$perr" >&2; rm -rf "$work"; exit 2; fi
+base=""; cmd=""; ntest=0
+: > "$work/files"; : > "$work/tfiles"
+while IFS= read -r line; do
+  case $line in
+    "base "*) base=${line#base } ;;
+    "command "*) cmd=${line#command } ;;
+    "file "*) printf '%s\n' "${line#file }" >> "$work/files" ;;
+    "test "*) ntest=$((ntest + 1))
+      f=${line#test }; f=${f%%"	"*}
+      seen=0
+      while IFS= read -r g; do [ "$g" = "$f" ] && { seen=1; break; }; done < "$work/tfiles"
+      [ "$seen" -eq 1 ] || printf '%s\n' "$f" >> "$work/tfiles" ;;
+  esac
+done < "$rec"
+if [ "$ntest" -eq 0 ]; then echo "verify-tests: $id: no named tests"; rm -rf "$work"; exit 0; fi
+if [ "$base" = "-" ]; then echo "verify-tests: $id: no base_sha (set the task running first)" >&2; rm -rf "$work"; exit 2; fi
+
+# Step 4: the repository, one HEAD commit, a real base commit.
+fault() { echo "verify-tests: $id: $1" >&2; rm -rf "$work"; exit 2; }
+repo=$(git -C "$(dirname -- "$plan")" rev-parse --show-toplevel 2>/dev/null) || fault "not in a git repository"
+git -C "$repo" worktree prune >/dev/null 2>&1
+head=$(git -C "$repo" rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null) || fault "cannot read HEAD"
+git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || fault "base_sha $base is not a commit"
+
+after="$work/after"; before="$work/before"; child=""
+# Step 9. Removes only the two worktrees this run made; returns non-zero if anything is left.
+cleanup() {
+  crc=0
+  for w in "$after" "$before"; do
+    if [ -d "$w" ]; then
+      git -C "$repo" worktree remove --force "$w" >/dev/null 2>&1 || crc=1
+    fi
+  done
+  rm -rf "$work" 2>/dev/null || crc=1
+  [ -e "$work" ] && crc=1
+  return "$crc"
+}
+on_signal() {
+  trap '' INT TERM HUP
+  if [ -n "$child" ]; then kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; fi
+  cleanup
+  echo "verify-tests: $id: interrupted" >&2
+  exit 2
+}
+trap on_signal INT TERM HUP
+gitfail() { echo "verify-tests: $id: $1" >&2; cleanup || echo "verify-tests: $id: cleanup failed" >&2; exit 2; }
+
+# Steps 5 and 6: the after tree, then the before tree with this task's code put back.
+git -C "$repo" worktree add --detach "$after" "$head" >&2 </dev/null || gitfail "cannot make the after tree"
+git -C "$repo" worktree add --detach "$before" "$head" >&2 </dev/null || gitfail "cannot make the before tree"
+while IFS= read -r p; do
+  is_test=0
+  while IFS= read -r g; do [ "$g" = "$p" ] && { is_test=1; break; }; done < "$work/tfiles"
+  [ "$is_test" -eq 1 ] && continue
+  if git -C "$before" cat-file -e "$base:$p" 2>/dev/null </dev/null; then
+    git --literal-pathspecs -C "$before" checkout -q "$base" -- "$p" >&2 </dev/null || gitfail "cannot put $p back to base_sha"
+  else
+    rm -rf -- "${before:?}/$p"
+  fi
+done < "$work/files"
+
