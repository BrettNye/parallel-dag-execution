+# entry, then the before block to one with a not-red or ok-absent entry; both come from the kept
+# run output, so they must be read before cleanup removes it.
+tails=$(
+  k=0
+  while IFS= read -r line; do
+    case $line in "T "*) ;; *) continue ;; esac
+    f=${line#T }; k=$((k + 1))
+    for side in after before; do
+      if [ "$side" = after ]; then want='not-green|ambiguous'; else want='not-red|ok-absent'; fi
+      hit=$(printf '%s\n' "$res" | VT_F=$f VT_W=$want awk -F '\t' '
+        BEGIN { n = split(ENVIRON["VT_W"], w, "|") }
