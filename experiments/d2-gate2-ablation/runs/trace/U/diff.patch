+'
+out="$(ps tests "$tmp/t-pl.md" task-c 2>"$tmp/t-err")"; rc=$?
+chk "tests: plan-level rule 16 lines on stderr" "$rc:$out:$(cat "$tmp/t-err")" "2::plan-state: rule 16: test_command has no {file}
+plan-state: rule 16: test_pass_prefix is empty"
+tt_plan "$tmp/t-bad.md" ""
+awk '{ print } /^  - y :: two words$/ { print "  - nocolons" }' "$tmp/t-bad.md" > "$tmp/t-bad2.md"
+out="$(ps tests "$tmp/t-bad2.md" task-a 2>"$tmp/t-err")"; rc=$?
+chk "tests: bad entry in this task" "$rc:$out:$(rg -c 'plan-state: task-a has a bad tests entry; run: plan-state check' "$tmp/t-err")" "2::1"
+out="$(ps tests "$tmp/t-bad2.md" task-c 2>/dev/null | sed -n 1p)"; rc=$?
+chk "tests: bad entry in another task is ignored" "$rc:$out" "0:base -"
+
