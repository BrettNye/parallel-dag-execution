+    for (k = 1; k <= nfile; k++) { scan("after", k); scan("before", k) }
+    good = 0; badn = 0
+    for (e = 1; e <= n; e++) {
+      a = state("after", e); b = state("before", e)
+      if (a == "ambiguous" || b == "ambiguous") l = "ambiguous"
+      else if (a != "passed") l = "not-green"
+      else if (b == "passed") l = "not-red"
+      else if (b == "absent") l = "ok-absent"
+      else l = "ok"
+      if (l == "ok" || l == "ok-absent") good++; else badn++
+      print l "\t" ef[e] "\t" ec[e]
+    }
