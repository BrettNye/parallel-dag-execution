+#!/usr/bin/env bash
+# Test suite for skills/executing-dag-plans/verify-tests
+REPO="$(cd "$(dirname "$0")/../.." && pwd)"
+SCRIPT="$REPO/skills/executing-dag-plans/verify-tests"
+[ -f "$SCRIPT" ] || { echo "FAIL: verify-tests not found at $SCRIPT" >&2; exit 1; }
+command -v rg >/dev/null 2>&1 || { echo "tests need rg (ripgrep)" >&2; exit 2; }
+if command -v dash >/dev/null 2>&1; then ALTSH=dash; else ALTSH=sh; echo "NOTE: dash not installed - alt-shell cases run under sh"; fi
+fails=0; passes=0
+ok()   { passes=$((passes+1)); echo "  PASS: $1"; }
+bad()  { fails=$((fails+1));  echo "  FAIL: $1"; }
+chk()  { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1 (expected [$3] got [$2])"; fi; }
+has()  { if printf '%s\n' "$2" | rg -qF -- "$3"; then ok "$1"; else bad "$1 (missing [$3] in: $2)"; fi; }
+hasnt(){ if printf '%s\n' "$2" | rg -qF -- "$3"; then bad "$1 (unexpected [$3] in: $2)"; else ok "$1"; fi; }
+
+tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
+
+# A one-task plan. $2 is the lines after files: (tests:, base_sha: and so on).
+mkplan() {
+  { printf -- '---\ntitle: demo\ncreated: 2026-11-17\n---\n\n```mermaid\nflowchart TD\n```\n\n## Task: one\n\n```yaml\nid: task-a\ndepends_on: []\nfiles:\n  - t/a.sh\n'
+    [ -n "$2" ] && printf '%s\n' "$2"
+    printf 'status: pending\n```\n\nBody.\n'
+  } > "$1"
+}
+mkplan "$tmp/notests.md" ""
+mkplan "$tmp/nobase.md" "tests:
+  - t/a.sh :: first case"
+
+# run <shell> <args...>: run verify-tests under <shell>; sets rc, out and err.
+run() { sh_="$1"; shift; "$sh_" "$SCRIPT" "$@" >"$tmp/o" 2>"$tmp/e"; rc=$?; out="$(cat "$tmp/o")"; err="$(cat "$tmp/e")"; }
+
+echo "T1: argument checks"
+acc=""
+for n in 0 1 3; do
+  case $n in 0) set -- ;; 1) set -- "$tmp/notests.md" ;; 3) set -- a b c ;; esac
+  run sh "$@"
+  m_=$(printf '%s\n' "$err" | rg -cF "verify-tests <plan> <id>")
+  acc="$acc [$rc:$out:$m_]"
+done
+chk "args: no arguments is usage" "$acc" " [2::1] [2::1] [2::1]"
+
+run sh "$tmp/notests.md" zz
+m_=$(printf '%s\n' "$err" | rg -cF "plan-state: no task with id zz")
+chk "args: plan-state error is relayed" "$rc:$out:$m_" "2::1"
+run sh "$tmp/missing.md" task-a
+m_=$(printf '%s\n' "$err" | rg -cF "plan-state: cannot read")
+chk "args: unreadable plan is relayed" "$rc:$out:$m_" "2::1"
+
+run sh "$tmp/notests.md" task-a
+chk "args: no named tests exits 0" "$rc:$out" "0:verify-tests: task-a: no named tests"
+
+run sh "$tmp/nobase.md" task-a
+m_=$(printf '%s\n' "$err" | rg -cF "verify-tests: task-a: no base_sha (set the task running first)")
+chk "args: no base_sha exits 2" "$rc:$out:$m_" "2::1"
+
+echo "T2: runs under a second POSIX shell ($ALTSH)"
+run "$ALTSH" a b c;                    r1=$rc
+run "$ALTSH" "$tmp/notests.md" zz;     r2=$rc
+run "$ALTSH" "$tmp/missing.md" task-a; r3=$rc
+run "$ALTSH" "$tmp/notests.md" task-a; r4=$rc:$out
+run "$ALTSH" "$tmp/nobase.md" task-a;  r5=$rc
+chk "args: runs under dash" "$r1 $r2 $r3 $r4 $r5" "2 2 2 0:verify-tests: task-a: no named tests 2"
+
+echo "T3: line endings"
+chk "eol: attribute is lf" "$(git -C "$REPO" check-attr eol -- skills/executing-dag-plans/verify-tests)" "skills/executing-dag-plans/verify-tests: eol: lf"
+if [ "$(tr -cd '\r' < "$SCRIPT" | wc -c)" -eq 0 ]; then ok "eol: script has no CR"; else bad "eol: script has no CR"; fi
+
+# ---------------------------------------------------------------------------
+# Tree cases. Each builds a small repository: lib.sh holds V=0 at base_sha and
+# ${LIB1:-V=1} after; the suite at ${SP:-t/demo.test.sh} sources lib.sh and runs
+# the body given to mkrepo. With VT_SLOW set, the suite touches $VT_SLOW.start,
+# sleeps, then touches $VT_SLOW.done, so a signal can land while it runs.
+PS="$REPO/skills/writing-dag-plans/plan-state"
+td="$tmp/td"; mkdir -p "$td"     # the TMPDIR every verify-tests run gets
+: > "$tmp/allout"                # every run's stdout, for the git-stdout case
+
+# mkrepo <dir> <suite body> <tests: lines>. Globals: FM (extra front matter),
+# SP (suite path), LIB1 (lib.sh after), NEWF (a file added after base, declared in files:).
+mkrepo() {
+  d_=$1; sp_=${SP:-t/demo.test.sh}
+  mkdir -p "$d_/t"
+  git -C "$d_" init -q && git -C "$d_" config user.email t@example.com && git -C "$d_" config user.name t && git -C "$d_" config core.autocrlf false
+  printf 'V=0\n' > "$d_/lib.sh"
+  { printf '. ./lib.sh\n'
+    printf 'if [ -n "${VT_SLOW:-}" ]; then : > "$VT_SLOW.start"; sleep 4; : > "$VT_SLOW.done"; fi\n'
+    printf '%s\n' "$2"; } > "$d_/$sp_"
+  { printf -- '---\ntitle: demo\ncreated: 2026-11-17\n'
+    [ -n "${FM:-}" ] && printf '%s\n' "$FM"
+    printf -- '---\n\n```mermaid\nflowchart TD\n```\n\n## Task: one\n\n```yaml\nid: T1\ndepends_on: []\nfiles:\n  - lib.sh\n  - %s\n' "$sp_"
+    [ -n "${NEWF:-}" ] && printf '  - %s\n' "$NEWF"
+    printf 'tests:\n%s\nstatus: pending\n```\n\nBody.\n' "$3"
+  } > "$d_/plan.md"
+  git -C "$d_" add -A && git -C "$d_" commit -qm base
+  { sh "$PS" set "$d_/plan.md" T1 ready && sh "$PS" set "$d_/plan.md" T1 running; } >/dev/null || echo "mkrepo: plan-state set failed in $d_" >&2
+  printf '%s\n' "${LIB1:-V=1}" > "$d_/lib.sh"
+  [ -n "${NEWF:-}" ] && printf 'x\n' > "$d_/$NEWF"
+  git -C "$d_" add lib.sh ${NEWF:+"$NEWF"} && git -C "$d_" commit -qm change
+}
+# vt <shell> <plan> <id>: run verify-tests with TMPDIR=$td; sets rc, out, err.
+vt() { sh_=$1; shift; TMPDIR="$td" "$sh_" "$SCRIPT" "$@" >"$tmp/o" 2>"$tmp/e"; rc=$?
+  full="$(cat "$tmp/o")"; err="$(cat "$tmp/e")"; cat "$tmp/o" >> "$tmp/allout"
+  # out is the label and total lines only (it drops tail-shaped lines, so whole-stdout
+  # assertions must use full); full also has the output tails (see T8).
+  out="$(rg -v '^(--- .+ \((after|before)\)|  \| .*)$' "$tmp/o")"; }
+wtn() { git -C "$1" worktree list | wc -l | tr -d ' '; }   # 1 means only the main tree
+tdempty() { [ -z "$(ls -A "$td")" ] && echo empty || echo "not empty: $(ls -A "$td")"; }
+RG='if [ "$V" = 1 ]; then echo "PASS: adds"; else echo "FAIL: adds (expected 1 got $V)"; fi'
+
+echo "T4: labels"
+mkrepo "$tmp/r1" "$RG" "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r1/plan.md" T1
+chk "trees: red then green is ok" "$rc:$out" "0:ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+r1wt="$rc:$(wtn "$tmp/r1"):$(tdempty)"
+
+mkrepo "$tmp/r2" 'if [ "$V" = 1 ]; then echo "PASS: muls"; fi' "  - t/demo.test.sh :: muls"
+vt sh "$tmp/r2/plan.md" T1
+chk "trees: absent before is ok-absent" "$rc:$out" "0:ok-absent	t/demo.test.sh	muls
+verify-tests: T1: 1 ok, 0 failed"
+
+mkrepo "$tmp/r3" 'echo "PASS: adds"' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r3/plan.md" T1
+chk "trees: passing before is not-red" "$rc:$out" "1:not-red	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+r3wt="$rc:$(wtn "$tmp/r3"):$(tdempty)"
+
+mkrepo "$tmp/r4" 'echo "FAIL: adds (still broken)"' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r4/plan.md" T1
+chk "trees: failing after is not-green" "$rc:$out" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+mkrepo "$tmp/r5" 'if [ "$V" = 0 ]; then echo "PASS: adds"; else echo "FAIL: adds (broke it)"; fi' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r5/plan.md" T1
+chk "trees: not-green wins over not-red" "$rc:$out" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+mkrepo "$tmp/r6" 'echo "PASS: adds"; echo "PASS: adds"' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r6/plan.md" T1
+chk "trees: duplicate name is ambiguous" "$rc:$out" "1:ambiguous	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+mkrepo "$tmp/r7" 'if [ "$V" = 1 ]; then echo "PASS: x"; echo "PASS: x2"; echo "PASS: exit 0 with charter"
+else echo "  FAIL: x (expected [1] got [2])"; echo "FAIL: exit 0"; fi' "  - t/demo.test.sh :: x
+  - t/demo.test.sh :: x2
+  - t/demo.test.sh :: exit 0"
+vt sh "$tmp/r7/plan.md" T1
+chk "trees: fail line with ( detail matches" "$rc:$out" "1:ok	t/demo.test.sh	x
+ok-absent	t/demo.test.sh	x2
+not-green	t/demo.test.sh	exit 0
+verify-tests: T1: 2 ok, 1 failed"
+
+FM='test_command: sh {file}
+test_pass_prefix: "ok - "
+test_fail_prefix: "not ok - "' \
+mkrepo "$tmp/r8" 'if [ "$V" = 1 ]; then echo "ok - adds"; else echo "not ok - adds"; fi' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r8/plan.md" T1
+chk "trees: custom command and prefixes" "$rc:$out" "0:ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+SP="t/it's a.test.sh" mkrepo "$tmp/r9" "$RG" "  - t/it's a.test.sh :: adds"
+vt sh "$tmp/r9/plan.md" T1
+chk "trees: file with a space and a quote" "$rc:$out" "0:ok	t/it's a.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+LIB1='V=0 # still red' mkrepo "$tmp/r10" "$RG" "  - t/demo.test.sh :: adds"
+printf 'V=1\n' > "$tmp/r10/lib.sh"     # uncommitted: would make the case pass
+st0="$(git -C "$tmp/r10" status --porcelain)"; pl0="$(cksum < "$tmp/r10/plan.md")"; hd0="$(git -C "$tmp/r10" rev-parse HEAD)"
+vt sh "$tmp/r10/plan.md" T1
+chk "trees: uncommitted change is ignored" "$rc:$out" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+chk "trees: shared tree untouched" "$rc|$(git -C "$tmp/r10" status --porcelain)|$(cksum < "$tmp/r10/plan.md")|$(git -C "$tmp/r10" rev-parse HEAD)" "1|$st0|$pl0|$hd0"
+
+NEWF=new.sh mkrepo "$tmp/r11" 'if [ -f new.sh ]; then echo "PASS: adds"; else echo "FAIL: adds (new.sh missing)"; fi' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r11/plan.md" T1
+chk "trees: before tree deletes a path new since base" "$rc:$out" "0:ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+mkrepo "$tmp/r12" 'if [ "$V" = 1 ]; then echo "PASS: a"; echo "PASS: b"; else echo "FAIL: a"; echo "FAIL: b"; fi' "  - t/demo.test.sh :: b
+  - t/demo.test.sh :: a"
+vt sh "$tmp/r12/plan.md" T1
+chk "trees: two entries keep tests: order" "$rc:$out" "0:ok	t/demo.test.sh	b
+ok	t/demo.test.sh	a
+verify-tests: T1: 2 ok, 0 failed"
+
+mkrepo "$tmp/r13" "$RG" "  - t/demo.test.sh :: adds"
+awk '{ if ($0 ~ /^base_sha:/) print "base_sha: 0000000"; else print }' "$tmp/r13/plan.md" > "$tmp/p13" && cp "$tmp/p13" "$tmp/r13/plan.md"
+vt sh "$tmp/r13/plan.md" T1
+m_=$(printf '%s\n' "$err" | rg -cF "is not a commit")
+chk "trees: base_sha not a commit" "$rc:$out:$m_" "2::1"
+
+chk "trees: no worktree or temp dir left" "$r1wt $r3wt $(wtn "$tmp/r13"):$(tdempty)" "0:1:empty 1:1:empty 1:empty"
+
+mkrepo "$tmp/r14" 'if [ -f dep.sh ]; then . ./dep.sh; fi; if [ "${D:-0}" = 1 ]; then echo "PASS: adds"; else echo "FAIL: adds (no dep.sh)"; fi' "  - t/demo.test.sh :: adds"
+printf 'dep.sh\n' > "$tmp/r14/.gitignore"; git -C "$tmp/r14" add .gitignore && git -C "$tmp/r14" commit -qm ignore
+printf 'D=1\n' > "$tmp/r14/dep.sh"     # ignored, so only the shared tree has it
+vt sh "$tmp/r14/plan.md" T1
+chk "trees: ignored dependency is not in the after tree" "$rc:$out" "1:not-green	t/demo.test.sh	adds
+verify-tests: T1: 0 ok, 1 failed"
+
+echo "T5: signals"
+# sigrun <shell> <signal> <plan>: start verify-tests with a slow suite, signal it once the
+# suite has started, wait. set -m keeps the job's INT from being ignored (a background job
+# of a shell without job control ignores INT, and a shell cannot trap an ignored signal).
+sigrun() { rm -f "$tmp/slow.start" "$tmp/slow.done"
+  set -m
+  VT_SLOW="$tmp/slow" TMPDIR="$td" "$1" "$SCRIPT" "$3" T1 >"$tmp/o" 2>"$tmp/e" &
+  pid_=$!
+  set +m
+  n_=0; while [ ! -f "$tmp/slow.start" ] && [ "$n_" -lt 300 ] && kill -0 "$pid_" 2>/dev/null; do sleep 0.1; n_=$((n_+1)); done
+  kill -s "$2" "$pid_" 2>/dev/null
+  n_=0; while kill -0 "$pid_" 2>/dev/null && [ "$n_" -lt 300 ]; do sleep 0.1; n_=$((n_+1)); done
+  kill -s KILL "$pid_" 2>/dev/null   # a run that is still going after 30 s is hung; stop it
+  { wait "$pid_"; rc=$?; } 2>/dev/null
+  out="$(cat "$tmp/o")"; err="$(cat "$tmp/e")"; cat "$tmp/o" >> "$tmp/allout"
+}
+mkrepo "$tmp/s1" "$RG" "  - t/demo.test.sh :: adds"
+for sig in TERM INT HUP; do
+  acc=""
+  for s_ in sh "$ALTSH"; do
+    sigrun "$s_" "$sig" "$tmp/s1/plan.md"
+    m_=$(printf '%s\n' "$err" | rg -cF "verify-tests: T1: interrupted")
+    acc="$acc [$rc:$m_:$(wtn "$tmp/s1"):$(tdempty)]"
+  done
+  chk "signals: $sig mid-run cleans up" "$acc" " [2:1:1:empty] [2:1:1:empty]"
+done
+
+acc=""
+for s_ in sh "$ALTSH"; do
+  VERIFY_TESTS_CLEANUP_HOOK='kill -s TERM "$PPID"; sleep 1' sigrun "$s_" TERM "$tmp/s1/plan.md"
+  m_=$(printf '%s\n' "$err" | rg -cF "verify-tests: T1: interrupted")
+  acc="$acc [$rc:$m_:$(wtn "$tmp/s1"):$(tdempty)]"
+done
+chk "signals: second signal during cleanup still exits 2" "$acc" " [2:1:1:empty] [2:1:1:empty]"
+
+acc=""
+for s_ in sh "$ALTSH"; do
+  sigrun "$s_" KILL "$tmp/s1/plan.md"
+  n_=0; while [ -f "$tmp/slow.start" ] && [ ! -f "$tmp/slow.done" ] && [ "$n_" -lt 100 ]; do sleep 0.1; n_=$((n_+1)); done
+  sleep 1                     # let the orphaned suite exit
+  k_=$(wtn "$tmp/s1")         # the two worktrees KILL left registered
+  rm -rf "$td"/*              # the leaked temporary directory, as a tmp cleaner would remove it
+  vt "$s_" "$tmp/s1/plan.md" T1
+  acc="$acc [$k_:$rc:$(wtn "$tmp/s1"):$(tdempty)]"
+done
+chk "signals: KILL leaves a registration the next run prunes" "$acc" " [3:0:1:empty] [3:0:1:empty]"
+
+echo "T6: cleanup"
+VERIFY_TESTS_CLEANUP_HOOK='git -C "$1/after" worktree lock "$1/after" >/dev/null 2>&1' vt sh "$tmp/r1/plan.md" T1
+m_=$(printf '%s\n' "$err" | rg -cF "verify-tests: T1: cleanup failed")
+chk "cleanup: failed removal exits 2" "$rc:$m_" "2:1"
+rm -f "$tmp/r1/.git/worktrees/"*/locked; git -C "$tmp/r1" worktree prune; rm -rf "$td"/*
+
+echo "T7: stdout"
+t7re='^((ok|ok-absent|not-red|not-green|ambiguous)	[^	]+	.+|verify-tests: T1: [0-9]+ ok, [0-9]+ failed|--- .+ \((after|before)\)|  \| .*)$'
+n_=$(rg -cv "$t7re" "$tmp/allout"); nrc_=$?
+# rg exits 1 when no line is stray and 2 on a bad regex; 2 must not pass as zero stray lines.
+[ "$nrc_" -le 1 ] || bad "trees: stdout shape regex is invalid (rg exit $nrc_)"
+chk "trees: stdout shape regex flags a stray line" "$(printf 'HEAD is now at abc\n' | rg -cv "$t7re")" "1"
+chk "trees: git stdout never reaches stdout" "$(rg -c "^verify-tests: T1: " "$tmp/allout" | awk '{ print ($1 > 0) ? "totals" : "none" }'):${n_:-0}:$(rg -c 'HEAD is now at|Preparing worktree' "$tmp/allout" || echo 0)" "totals:0:0"
+
+echo "T8: output tails"
+# addf <dir> <path> <suite body>: commit one more suite after the change commit.
+addf() { { printf '. ./lib.sh\n%s\n' "$3"; } > "$1/$2"; git -C "$1" add "$2" && git -C "$1" commit -qm "add $2"; }
+
+SP=t/a.sh NEWF=t/b.sh mkrepo "$tmp/r20" 'if [ "$V" = 1 ]; then echo "PASS: x"; fi' "  - t/a.sh :: x
+  - t/b.sh :: y"
+addf "$tmp/r20" t/b.sh 'echo "FAIL: y"'
+vt sh "$tmp/r20/plan.md" T1
+chk "tails: spec example order" "$(printf '%s\n' "$full" | rg '^(---|ok|not|verify)')" "ok-absent	t/a.sh	x
+not-green	t/b.sh	y
+verify-tests: T1: 1 ok, 1 failed
+--- t/a.sh (before)
+--- t/b.sh (after)"
+
+mkrepo "$tmp/r21" 'i=1; while [ "$i" -le 30 ]; do echo "line $i"; i=$((i+1)); done; echo "FAIL: adds"' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r21/plan.md" T1
+blk_=$(printf '%s\n' "$full" | sed -n '/^--- /,$p')
+chk "tails: last 20 lines only" "$(printf '%s\n' "$blk_" | rg -c '^  \| '):$(printf '%s\n' "$blk_" | tail -n 2 | head -n 1):$(printf '%s\n' "$blk_" | tail -n 1)" "20:  | line 30:  | FAIL: adds"
+
+mkrepo "$tmp/r22" 'if [ "$V" = 0 ]; then echo "PASS: adds"; else echo "FAIL: adds (broke it)"; fi' "  - t/demo.test.sh :: adds"
+vt sh "$tmp/r22/plan.md" T1
+chk "tails: not-red and not-green gives only after" "$(printf '%s\n' "$full" | rg '^---')" "--- t/demo.test.sh (after)"
+
+mkrepo "$tmp/r23" 'echo "FAIL: x"; if [ "$V" = 1 ]; then echo "PASS: y"; fi' "  - t/demo.test.sh :: x
+  - t/demo.test.sh :: y"
+vt sh "$tmp/r23/plan.md" T1
+chk "tails: one file gives after then before" "$(printf '%s\n' "$full" | rg '^---')" "--- t/demo.test.sh (after)
+--- t/demo.test.sh (before)"
+
+SP=t/b.sh NEWF=t/a.sh mkrepo "$tmp/r24" 'echo "FAIL: p"' "  - t/b.sh :: p
+  - t/a.sh :: q"
+addf "$tmp/r24" t/a.sh 'echo "FAIL: q"'
+vt sh "$tmp/r24/plan.md" T1
+chk "tails: file order follows tests:" "$(printf '%s\n' "$full" | rg '^---')" "--- t/b.sh (after)
+--- t/a.sh (after)"
+
+SP=t/missing.sh mkrepo "$tmp/r25" "$RG" "  - t/missing.sh :: adds"
+git -C "$tmp/r25" rm -q t/missing.sh && git -C "$tmp/r25" commit -qm "drop the suite"
+vt sh "$tmp/r25/plan.md" T1
+chk "tails: no output shows placeholder" "$(printf '%s\n' "$full" | sed -n '/^--- /,$p')" "--- t/missing.sh (after)
+  | (no output)"
+
+vt sh "$tmp/r1/plan.md" T1
+chk "tails: all ok prints no block" "$rc:$(printf '%s\n' "$full" | rg -c '^---' || echo 0):$full" "0:0:ok	t/demo.test.sh	adds
+verify-tests: T1: 1 ok, 0 failed"
+
+mkrepo "$tmp/r26" 'printf "FAIL: x\nPASS: y"' "  - t/demo.test.sh :: x
+  - t/demo.test.sh :: y"
+vt sh "$tmp/r26/plan.md" T1
+chk "tails: output without a trailing newline keeps headers on their own line" "$(printf '%s\n' "$full" | rg -c '^--- t/demo.test.sh \((after|before)\)$'):$(printf '%s\n' "$full" | rg -c '[^ ]--- ' || echo 0)" "2:0"
+
+echo "RESULT: $passes passed, $fails failed"
+[ "$fails" -eq 0 ]
