index 0000000..5343811
--- /dev/null
+++ b/skills/executing-dag-plans/verify-tests
@@ -0,0 +1,200 @@
+#!/usr/bin/env sh
+# verify-tests — check that a task's named test cases were red before its change and green after.
+# Usage: verify-tests <plan> <id>
+# Exit: 0 every entry ok, or no entries; 1 at least one entry failed;
+#       2 usage, plan-state tests error, no base_sha, git failure, interrupt, or cleanup failure.
+# It never writes to the plan, touches the shared working tree or index, or commits.
+# Trees: two detached worktrees at HEAD under a mktemp -d directory; in the before tree every
+#   path of the task's files: that is not one of its test files is put back to base_sha.
+# Untracked files: only committed files are in the trees, so a suite that needs an untracked or
+#   git-ignored file fails there. Run on this repository (2026-11-17, base_sha 76ed77d^, files
+#   plan-state and its suite): the plan-state suite ran in full in both fresh worktrees, so this
+#   repo's suites need nothing untracked. Case 'round on "2" counts to 3' was labelled not-red
+#   (exit 1): at 76ed77d^ round already printed 3, it only failed to write it. Case
+#   'round on "2" writes review_rounds: 3' was labelled ok.
+# Bash tool timeout: the probe's log stayed empty (2026-11-17, Windows 11, Git Bash), because no
+#   signal was sent: at the timeout the tool moved the command to the background, where it ran to
+#   the end. A background run stopped at its own time limit also logged nothing: the tool killed
+#   only its outer shell and the probe went on running. Either way verify-tests is not signalled
+#   and finishes its own cleanup. Probe, run with timeout 5000:
+#   sh -c 'trap "echo INT >> /tmp/vt-probe.log; exit 2" INT; trap "echo TERM >> /tmp/vt-probe.log; exit 2" TERM; trap "echo HUP >> /tmp/vt-probe.log; exit 2" HUP; sleep 60 & wait'
+# Test-only hook: VERIFY_TESTS_CLEANUP_HOOK, when set, runs as sh -c "$hook" sh <tempdir> at the
+#   start of every cleanup, so the suite can slow cleanup down or make a removal fail.
+set -u
+usage() { sed -n '3,5p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
+[ "$#" -eq 2 ] || usage
+plan=$1; id=$2
+here=$(cd "$(dirname -- "$0")" && pwd)
+ps="$here/../writing-dag-plans/plan-state"
+work=$(mktemp -d) || exit 2
+repo=""; child=""
+
+# Step 9: remove both worktrees and the temporary directory. Returns 1 when anything is left.
+cleanup() {
+  [ -n "${VERIFY_TESTS_CLEANUP_HOOK:-}" ] && sh -c "$VERIFY_TESTS_CLEANUP_HOOK" sh "$work"
+  crc=0
+  for w in "$work/after" "$work/before"; do
+    if [ -d "$w" ]; then git -C "$repo" worktree remove --force "$w" >/dev/null 2>&1 || crc=1; fi
+  done
+  rm -rf "$work" 2>/dev/null; [ -e "$work" ] && crc=1
+  return "$crc"
+}
+# Stop the running suite, clean up, exit 2. Further signals are ignored while it does so.
+on_signal() {
+  trap '' INT TERM HUP
+  if [ -n "$child" ]; then kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; fi
+  cleanup || echo "verify-tests: $id: cleanup failed" >&2
+  echo "verify-tests: $id: interrupted" >&2
+  exit 2
+}
+trap on_signal INT TERM HUP
+bail() {
+  trap '' INT TERM HUP
+  echo "verify-tests: $id: $1" >&2
+  cleanup || echo "verify-tests: $id: cleanup failed" >&2
+  exit 2
+}
+
+rec="$work/rec"; perr="$work/err"
+if ! sh "$ps" tests "$plan" "$id" > "$rec" 2> "$perr"; then cat "$perr" >&2; rm -rf "$work"; exit 2; fi
+base=""; ntest=0
+while IFS= read -r line; do
+  case $line in
+    "base "*) base=${line#base } ;;
+    "test "*) ntest=$((ntest + 1)) ;;
+  esac
+done < "$rec"
+if [ "$ntest" -eq 0 ]; then echo "verify-tests: $id: no named tests"; rm -rf "$work"; exit 0; fi
+if [ "$base" = "-" ]; then echo "verify-tests: $id: no base_sha (set the task running first)" >&2; rm -rf "$work"; exit 2; fi
+
+# Step 4: the repository, the one HEAD both trees are built from, and base_sha.
+repo=$(git -C "$(dirname -- "$plan")" rev-parse --show-toplevel 2>/dev/null) || bail "not in a git repository"
+git -C "$repo" worktree prune >/dev/null 2>&1
+head=$(git -C "$repo" rev-parse --verify -q "HEAD^{commit}" 2>/dev/null) || bail "cannot read HEAD"
+git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || bail "base_sha $base is not a commit"
+
+# Distinct test files in first-seen order (T lines), and the files: paths to revert (R lines).
+awk '
+  substr($0, 1, 5) == "file " { f[++nf] = substr($0, 6) }
+  substr($0, 1, 5) == "test " { t = substr($0, 6); t = substr(t, 1, index(t, "\t") - 1)
+    if (!(t in seen)) { seen[t] = 1; print "T " t } }
+  END { for (i = 1; i <= nf; i++) if (!(f[i] in seen)) print "R " f[i] }
+' "$rec" > "$work/paths" || bail "cannot read the plan-state record"
+
+# Steps 5 and 6: the after tree, and the before tree with the task's code back at base_sha.
+after="$work/after"; before="$work/before"
+git -C "$repo" worktree add --detach "$after" "$head" >&2 || bail "cannot add the after tree"
